(melange.emit
 (target out)
 (alias client-dev-js)
 (modules client_main)
 (module_systems
  (esm mjs))
 (libraries silica_linear_app_melange silica.browser silica.json-melange)
 (preprocess
  (pps melange.ppx)))

(rule
 (copy ../client/app.css app.css))

(rule
 (targets
  (dir dist)
  meta.json)
 (deps
  (alias client-dev-js)
  app.css
  (source_tree ../client/node_modules))
 (action
  (progn
   (run
    ../client/node_modules/esbuild/bin/esbuild
    out/linear/client_dev/client_main.mjs
    app.css
    --bundle
    --format=esm
    --minify=%{env:SILICA_MINIFY=true}
    --outdir=dist
    --entry-names=[name]-[hash]
    --metafile=meta.json
    --sourcemap
    --sources-content=false
    --inject:out/node_modules/silica.browser/hot_reload.mjs)
   (run node %{dep:../../server/precompress.ts} dist))))
