open Silica
open Jsonkit.Primitives
open Linear_model
open Linear_routes

type text_field = Title_field | Description_field [@@deriving json]

type editor = {
  field : text_field;
  draft : string;
  base : int;
  note : string option;
}
[@@deriving json]

type event =
  | Loaded of (Issues.t, string) Silica_jsonkit.answer
  | Updated of Issues.t Silica_jsonkit.update
  | Retry
  | Reconnect
  | Reconnected
  | Edit of text_field
  | Draft_changed of string
  | Save
  | Cancel_edit
  | Picker of Linear_pickers.picker option
  | Pick of Change.t
  | Saved of int * (Change.answer, string) Silica_jsonkit.answer
  | Toast_closed of string
  | Menu_open of bool
  | Command of string
  | Create_key
  | Keep_editing
[@@deriving json]

let event_name = function
  | Loaded answer ->
      answer_name "loaded" answer
  | Updated _ ->
      "updated"
  | Retry ->
      "retry"
  | Reconnect ->
      "reconnect"
  | Reconnected ->
      "reconnected"
  | Edit _ ->
      "edit"
  | Draft_changed _ ->
      "draft_changed"
  | Save ->
      "save"
  | Cancel_edit ->
      "cancel_edit"
  | Picker (Some _) ->
      "picker open"
  | Picker None ->
      "picker closed"
  | Pick _ ->
      "pick"
  | Saved (_, answer) ->
      saved_name answer
  | Toast_closed _ ->
      "toast_closed"
  | Menu_open opened ->
      "menu_open " ^ string_of_bool opened
  | Command _ ->
      "command"
  | Create_key ->
      "create_key"
  | Keep_editing ->
      "keep_editing"

type view_state = {
  number : int;
  data : Linear_data.t;
  reconnecting : bool;
  editor : editor option;
  picker : Linear_pickers.picker option;
  toasts : Linear_data.Toast.t list;
  menu_open : bool;
}
[@@deriving json]

type state = Loading | Ready of view_state | Not_found | Failed of string
[@@deriving json]

let name = function
  | Loading ->
      "loading"
  | Ready _ ->
      "ready"
  | Not_found ->
      "not_found"
  | Failed _ ->
      "failed"

let states = [ "loading"; "ready"; "not_found"; "failed" ]

let title_input = Ref.make "title-input"
let description_input = Ref.make "description-input"

let input_ref = function
  | Title_field ->
      title_input
  | Description_field ->
      description_input

let text_of (issue : Issue.t) = function
  | Title_field ->
      issue.title
  | Description_field ->
      issue.description

let change_of field draft =
  match field with
  | Title_field ->
      Change.Title draft
  | Description_field ->
      Change.Description draft

let field_of_change : Change.t -> (text_field * string) option = function
  | Change.Title t ->
      Some (Title_field, t)
  | Change.Description d ->
      Some (Description_field, d)
  | Change.Status _ | Change.Priority _ | Change.Assignee _ | Change.Labels _ ->
      None

let add_toast state id request outcome =
  match Linear_data.toast id request outcome with
  | Some toast ->
      { state with toasts = state.toasts @ [ toast ] }
  | None ->
      state

let conflict_note (current : Issue.t) field =
  "ENG-"
  ^ string_of_int current.number
  ^ " changed while you edited. The "
  ^ ( match field with
    | Title_field ->
        "title is now \"" ^ current.title ^ "\""
    | Description_field ->
        "description is now \"" ^ current.description ^ "\""
    )
  ^ ". Your text is kept: save again to replace it."

let finished state id answer : (state, event) Machine.next =
  let data, outcome = Linear_data.finish id answer state.data in
  let state = { state with data } in
  match outcome with
  | None | Some (_, Linear_data.Saved) ->
      Go (Ready state)
  | Some (request, (Linear_data.Conflict current as outcome)) -> (
      match field_of_change request.change with
      | Some (field, draft) when request.number = state.number ->
          Go_with
            ( Ready
                {
                  state with
                  editor =
                    Some
                      {
                        field;
                        draft;
                        base = current.version;
                        note = Some (conflict_note current field);
                      };
                },
              [ Action.Focus (input_ref field) ]
            )
      | Some _ | None ->
          Go (Ready (add_toast state id request outcome))
    )
  | Some (request, (Linear_data.Failed _ as outcome)) ->
      Go (Ready (add_toast state id request outcome))

let save state (editor : editor) : (state, event) Machine.next =
  match Change.check (change_of editor.field editor.draft) with
  | Error message ->
      Go (Ready { state with editor = Some { editor with note = Some message } })
  | Ok change ->
      Go
        (Ready
           {
             state with
             editor = None;
             data =
               Linear_data.start ~base:editor.base state.number change
                 state.data;
           }
        )

let ready state : event -> (state, event) Machine.next = function
  | Updated update ->
      Go (Ready { state with data = Linear_data.apply update state.data })
  | Reconnect ->
      Go (Ready { state with reconnecting = true })
  | Reconnected ->
      Go (Ready { state with reconnecting = false })
  | Edit field -> (
      match Linear_data.find state.number state.data with
      | Some issue ->
          Go_with
            ( Ready
                {
                  state with
                  editor =
                    Some
                      {
                        field;
                        draft = text_of issue field;
                        base = issue.version;
                        note = None;
                      };
                },
              [ Action.Focus (input_ref field) ]
            )
      | None ->
          Ignore
    )
  | Draft_changed draft -> (
      match state.editor with
      | Some editor ->
          Go (Ready { state with editor = Some { editor with draft } })
      | None ->
          Ignore
    )
  | Save -> (
      match state.editor with
      | Some editor ->
          save state editor
      | None ->
          Ignore
    )
  | Cancel_edit -> (
      match state.editor with
      | Some _ ->
          Go (Ready { state with editor = None })
      | None ->
          Ignore
    )
  | Keep_editing -> (
      match state.editor with
      | Some editor ->
          Stay [ Action.Focus (input_ref editor.field) ]
      | None ->
          Ignore
    )
  | Picker picker ->
      Go (Ready { state with picker })
  | Pick change ->
      Go
        (Ready
           {
             state with
             data = Linear_data.start state.number change state.data;
           }
        )
  | Saved (id, answer) ->
      finished state id answer
  | Toast_closed key ->
      Go
        (Ready
           {
             state with
             toasts =
               List.filter
                 (fun (t : Silica_ui.Toast.toast) -> t.key <> key)
                 state.toasts;
           }
        )
  | Menu_open menu_open ->
      Go (Ready { state with menu_open })
  | Create_key ->
      Stay [ Router.navigate routes (Issues { list with create = true }) ]
  | Command value -> (
      let issues = Linear_data.issues state.data in
      let focused = Linear_data.find state.number state.data in
      match Linear_commands.parse ~issues ~focused value with
      | Some Linear_commands.Create ->
          Stay [ Router.navigate routes (Issues { list with create = true }) ]
      | Some Linear_commands.Go_list ->
          Stay [ Router.navigate routes (Issues list) ]
      | Some (Linear_commands.Open number) ->
          Stay [ Router.navigate routes (Issue number) ]
      | Some (Linear_commands.Set change) ->
          Go
            (Ready
               {
                 state with
                 data = Linear_data.start state.number change state.data;
               }
            )
      | None ->
          Ignore
    )
  | Loaded _ | Retry ->
      Ignore

let picker_keys =
  Linear_pickers.
    [
      (Key.make "s", Picker (Some Status_picker));
      (Key.make "p", Picker (Some Priority_picker));
      (Key.make "a", Picker (Some Assignee_picker));
      (Key.make "l", Picker (Some Labels_picker));
      (Key.make "c", Create_key);
    ]
  @ Linear_commands.keys (Menu_open true)

let live (state : view_state) =
  if state.reconnecting then
    Source.after 0 Reconnected
  else
    Topic.subscribe issues_topic issues_key (fun update -> Updated update)

let page_title number data =
  match Linear_data.find number data with
  | Some issue ->
      Issue.identifier issue ^ " " ^ issue.title
  | None ->
      "ENG-" ^ string_of_int number

let machine =
  Machine.make_with_props ~id:"issue-detail" ~init:Loading ~name ~states
    ~event_name
    ~entry:(fun number -> function
      | Loading ->
          [ Action.Set_title ("ENG-" ^ string_of_int number) ]
      | Ready _ | Not_found | Failed _ ->
          []
      )
    ~during:(fun _ -> function
      | Loading ->
          [ Remote.call issues_endpoint () (fun answer -> Loaded answer) ]
      | Ready state ->
          live state
          :: Source.keys ~prevent:true picker_keys
          :: Linear_data.calls state.data (fun id answer -> Saved (id, answer))
      | Not_found | Failed _ ->
          []
      )
    ~on_props:(fun previous number state ->
      match (previous, state) with
      | None, _ ->
          Ignore
      | Some _, Ready ready ->
          Go_with
            ( Ready
                {
                  ready with
                  number;
                  editor = None;
                  picker = None;
                  menu_open = false;
                },
              [ Action.Set_title (page_title number ready.data) ]
            )
      | Some _, (Loading | Not_found | Failed _) ->
          Reenter Loading
    )
    (fun number state event ->
      match (state, event) with
      | Loading, Loaded (Ok issues) -> (
          let data = Linear_data.loaded issues in
          match Linear_data.find number data with
          | Some _ ->
              Go_with
                ( Ready
                    {
                      number;
                      data;
                      reconnecting = false;
                      editor = None;
                      picker = None;
                      toasts = [];
                      menu_open = false;
                    },
                  [ Action.Set_title (page_title number data) ]
                )
          | None ->
              Go_with (Not_found, [ Action.Set_status 404 ])
        )
      | Loading, Loaded (Rejected message) ->
          Go (Failed message)
      | Loading, Loaded (Failed error) ->
          Go (Failed (Remote.error_to_string error))
      | Ready state, event ->
          ready state event
      | Failed _, Retry ->
          Go Loading
      | (Loading | Not_found | Failed _), _ ->
          Ignore
    )

let text = Node.text

let back =
  Router.link routes (Issues list)
    [ Attr.string "class" "text-sm text-ui-muted hover:underline" ]
    [ text "Back to issues" ]

let property name value =
  <div class_="flex items-center gap-3 py-1 text-sm">
    <dt class_="w-24 shrink-0 text-ui-muted">(text name)</dt> <dd>value</dd>
  </div>

let input_class =
  "w-full rounded-ui border border-ui-border bg-ui-surface px-2 py-1"

let edit_button id label =
  <button
    id
    type_=`button
    class_="text-sm text-ui-muted underline"
    on_press=(Edit
                ( if id = "edit-title" then
                    Title_field
                  else
                    Description_field
                )
             )>
    (text label)
  </button>

let editor_view (editor : editor) =
  let keys key =
    if Key.equal key Key.escape then
      Some Cancel_edit
    else if
      Key.equal key (Key.make ~ctrl:true "Enter")
      || Key.equal key (Key.make ~meta:true "Enter")
      || (editor.field = Title_field && Key.equal key Key.enter)
    then
      Some Save
    else
      None
  in
  <div class_="mb-4 flex flex-col gap-2">
    ( match editor.field with
    | Title_field ->
        <input
          ref=title_input
          id="title-input"
          type_=`text
          aria_label="Title"
          class_=input_class
          value=editor.draft
          on_input=(fun value -> Draft_changed value)
          on_key_down=keys
        />
    | Description_field ->
        <textarea
          ref=description_input
          id="description-input"
          aria_label="Description"
          rows=6
          class_=input_class
          value=editor.draft
          on_input=(fun value -> Draft_changed value)
          on_key_down=keys
        />
    )
    ( match editor.note with
    | Some note ->
        <p id="edit-note" role=`alert class_="text-sm text-warning">
          (text note)
        </p>
    | None ->
        Node.list []
    )
    <div class_="flex gap-2">
      <button
        id="edit-save"
        type_=`button
        class_="rounded-ui bg-ui-accent px-3 py-1 text-sm text-ui-accent-text"
        on_press=Save>
        "Save"
      </button>
      <button
        id="edit-cancel"
        type_=`button
        class_="rounded-ui px-3 py-1 text-sm text-ui-muted"
        on_press=Cancel_edit>
        "Cancel"
      </button>
    </div>
  </div>

let toast_classes = Silica_ui.Style.toast

let issue_view (state : view_state) (issue : Issue.t) : event Node.t =
  let editing field =
    match state.editor with
    | Some editor when editor.field = field ->
        Some editor
    | _ ->
        None
  in
  Node.element "article"
    [
      Attr.string "id" "issue-detail";
      Attr.string "data-pending" (string_of_int (Linear_data.pending state.data));
    ]
    [
      ( if state.data.stale then
          <p id="issue-offline" class_="mb-2 text-sm text-warning">
            "Offline. Showing the last data received. "
            <button class_="underline" on_press=Reconnect>"Reconnect"</button>
          </p>
        else
          Node.list []
      );
      ( match state.editor with
      | Some editor when editor.draft <> text_of issue editor.field ->
          <Linear_unsaved on_keep=Keep_editing />
      | Some _ | None ->
          Node.list []
      );
      <p class_="text-sm text-ui-muted">(text (Issue.identifier issue))</p>;
      ( match editing Title_field with
      | Some editor ->
          editor_view editor
      | None ->
          <div class_="mb-4 flex items-baseline gap-3">
            <h1 class_="mb-4 text-xl font-semibold" dataSilicaRouteFocus="">
              (text issue.title)
            </h1>
            (edit_button "edit-title" "Edit title")
          </div>
      );
      ( match editing Description_field with
      | Some editor ->
          editor_view editor
      | None ->
          <div class_="mb-6">
            <p id="issue-description" class_="whitespace-pre-wrap">
              (text
                 ( if issue.description = "" then
                     "No description."
                   else
                     issue.description
                 )
              )
            </p>
            (edit_button "edit-description" "Edit description")
          </div>
      );
      <dl>
        (Node.list
           (List.map
              (fun (name, node) -> property name node)
              (Linear_pickers.view ~issue ~picker:state.picker
                 ~on_open:(fun p -> Picker p)
                 ~on_pick:(fun change -> Pick change)
              )
           )
        )
        (property "Created" (text (Linear_data.date_of_epoch issue.created_at)))
        (property "Updated" (text (Linear_data.date_of_epoch issue.updated_at)))
      </dl>;
      <Linear_comments number=issue.number />;
      Linear_commands.make ~open_:state.menu_open
        ~on_open_change:(fun opened -> Menu_open opened)
        ~on_run:(fun value -> Command value)
        ~issues:(Linear_data.issues state.data)
        ~focused:(Some issue);
      Silica_ui.Toast.make
        ~on_close:(fun key -> Toast_closed key)
        (Silica_ui.Toast.props ~id:"issue-toasts" ~classes:toast_classes
           state.toasts
        );
    ]

let view number state : event Node.t =
  <section>
    <p class_="mb-4">back</p>
    ( match state with
    | Loading ->
        <p class_="text-ui-muted">"Loading issue..."</p>
    | Not_found ->
        <p id="issue-not-found">
          (text ("There is no issue ENG-" ^ string_of_int number ^ "."))
        </p>
    | Failed message ->
        <div>
          <p role=`alert class_="text-ui-danger">(text message)</p>
          <button
            id="issue-retry"
            class_="mt-2 rounded-ui border border-ui-border px-3 py-1"
            on_press=Retry>
            "Try again"
          </button>
        </div>
    | Ready state -> (
        match Linear_data.find state.number state.data with
        | Some issue ->
            issue_view state issue
        | None ->
            <p id="issue-not-found">
              (text
                 ("There is no issue ENG-" ^ string_of_int state.number ^ ".")
              )
            </p>
      )
    )
  </section>

let component = Component.make_with_props machine view
let make ?key ~number () =
  Component.node_with_props ?key ~props:number component
