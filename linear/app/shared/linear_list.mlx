open Silica
open Jsonkit.Primitives
open Linear_model
open Linear_routes

type event =
  | Loaded of (Issues.t, string) Silica_jsonkit.answer
  | Updated of Issues.t Silica_jsonkit.update
  | Retry
  | Reconnect
  | Reconnected
  | Filter_open of bool
  | Filter_changed of Linear_view.filter
  | Grouping_picked of string
  | Ordering_picked of string
  | Toggle_group of Linear_view.group
  | Cursor_next
  | Cursor_previous
  | Row_focused of int
  | Menu_open of bool
  | Command of string
  | Create_key
  | Saved of int * (Change.answer, string) Silica_jsonkit.answer
  | Toast_closed of string
[@@deriving json]

let event_name = function
  | Loaded answer ->
      answer_name "loaded" answer
  | Updated _ ->
      "updated"
  | Retry ->
      "retry"
  | Reconnect ->
      "reconnect"
  | Reconnected ->
      "reconnected"
  | Filter_open opened ->
      "filter_open " ^ string_of_bool opened
  | Filter_changed _ ->
      "filter_changed"
  | Grouping_picked _ ->
      "grouping_picked"
  | Ordering_picked _ ->
      "ordering_picked"
  | Toggle_group _ ->
      "toggle_group"
  | Cursor_next ->
      "cursor_next"
  | Cursor_previous ->
      "cursor_previous"
  | Row_focused _ ->
      "row_focused"
  | Menu_open opened ->
      "menu_open " ^ string_of_bool opened
  | Command _ ->
      "command"
  | Create_key ->
      "create_key"
  | Saved (_, answer) ->
      saved_name answer
  | Toast_closed _ ->
      "toast_closed"

type ready = {
  data : Linear_data.t;
  reconnecting : bool;
  collapsed : Linear_view.group list;
  filter_open : bool;
  cursor : int option;
  menu_open : bool;
  toasts : Linear_data.Toast.t list;
}
[@@deriving json]

type state = Loading | Ready of ready | Failed of string [@@deriving json]

let name = function
  | Loading ->
      "loading"
  | Ready _ ->
      "ready"
  | Failed _ ->
      "failed"

let states = [ "loading"; "ready"; "failed" ]

let show view = Router.replace routes (Issues { create = false; view })
let row_ref number = Ref.make ("issue-row-" ^ string_of_int number)

let visible view (r : ready) =
  List.concat_map
    (fun (group, members) ->
      if List.mem group r.collapsed then
        []
      else
        List.map (fun (i : Issue.t) -> i.number) members
    )
    (Linear_view.groups view (Linear_data.issues r.data))

let move view (r : ready) step : (state, event) Machine.next =
  let rows = visible view r in
  let rec after = function
    | a :: (b :: _ as rest) ->
        if Some a = r.cursor then
          Some b
        else
          after rest
    | [ _ ] | [] ->
        None
  in
  let target =
    match r.cursor with
    | Some current when List.mem current rows -> (
        let ordered =
          match step with `Next -> rows | `Previous -> List.rev rows
        in
        match after ordered with Some next -> Some next | None -> Some current
      )
    | Some _ | None -> (
        match rows with first :: _ -> Some first | [] -> None
      )
  in
  match target with
  | Some number ->
      Go_with
        ( Ready { r with cursor = Some number },
          [ Action.Focus (row_ref number) ]
        )
  | None ->
      Stay []

let add_toast (r : ready) id request outcome =
  match Linear_data.toast id request outcome with
  | Some toast ->
      { r with toasts = r.toasts @ [ toast ] }
  | None ->
      r

let create view = Router.navigate routes (Issues { create = true; view })

let ready_event view (r : ready) : event -> (state, event) Machine.next =
  function
  | Updated update ->
      Go (Ready { r with data = Linear_data.apply update r.data })
  | Reconnect ->
      Go (Ready { r with reconnecting = true })
  | Reconnected ->
      Go (Ready { r with reconnecting = false })
  | Filter_open filter_open ->
      Go (Ready { r with filter_open })
  | Filter_changed filter ->
      Stay [ show { view with filter } ]
  | Grouping_picked name -> (
      match List.assoc_opt name Linear_view.grouping_names with
      | Some grouping ->
          Stay [ show { view with grouping } ]
      | None ->
          Ignore
    )
  | Ordering_picked name -> (
      match List.assoc_opt name Linear_view.ordering_names with
      | Some ordering ->
          Stay [ show { view with ordering } ]
      | None ->
          Ignore
    )
  | Toggle_group group ->
      let collapsed =
        if List.mem group r.collapsed then
          List.filter (fun g -> g <> group) r.collapsed
        else
          group :: r.collapsed
      in
      Go (Ready { r with collapsed })
  | Cursor_next ->
      move view r `Next
  | Cursor_previous ->
      move view r `Previous
  | Row_focused number ->
      Go (Ready { r with cursor = Some number })
  | Menu_open menu_open ->
      Go (Ready { r with menu_open })
  | Create_key ->
      Stay [ create view ]
  | Command value -> (
      let issues = Linear_data.issues r.data in
      let focused =
        Option.bind r.cursor (fun number -> Linear_data.find number r.data)
      in
      match (Linear_commands.parse ~issues ~focused value, focused) with
      | Some Linear_commands.Create, _ ->
          Stay [ create view ]
      | Some Linear_commands.Go_list, _ ->
          Stay [ Router.navigate routes (Issues list) ]
      | Some (Linear_commands.Open number), _ ->
          Stay [ Router.navigate routes (Issue number) ]
      | Some (Linear_commands.Set change), Some issue ->
          Go
            (Ready
               { r with data = Linear_data.start issue.number change r.data }
            )
      | Some (Linear_commands.Set _), None | None, _ ->
          Ignore
    )
  | Saved (id, answer) -> (
      let data, outcome = Linear_data.finish id answer r.data in
      let r = { r with data } in
      match outcome with
      | Some (request, outcome) ->
          Go (Ready (add_toast r id request outcome))
      | None ->
          Go (Ready r)
    )
  | Toast_closed key ->
      Go
        (Ready
           {
             r with
             toasts =
               List.filter
                 (fun (t : Silica_ui.Toast.toast) -> t.key <> key)
                 r.toasts;
           }
        )
  | Loaded _ | Retry ->
      Ignore

let list_keys =
  [
    (Key.make "f", Filter_open true);
    (Key.make "j", Cursor_next);
    (Key.make "k", Cursor_previous);
    (Key.arrow_down, Cursor_next);
    (Key.arrow_up, Cursor_previous);
    (Key.make "c", Create_key);
  ]
  @ Linear_commands.keys (Menu_open true)

let live (r : ready) =
  if r.reconnecting then
    Source.after 0 Reconnected
  else
    Source.live issues_topic issues_key (fun update -> Updated update)

let machine =
  Machine.make_with_props ~id:"issue-list" ~init:Loading ~name ~states
    ~event_name
    ~entry:(fun _ -> function
      | Loading -> [ Action.Set_title "Issues" ] | Ready _ | Failed _ -> []
      )
    ~during:(fun _ -> function
      | Loading ->
          [ Remote.call issues_endpoint () (fun answer -> Loaded answer) ]
      | Ready r ->
          live r
          :: Source.keys ~prevent:true list_keys
          :: Linear_data.calls r.data (fun id answer -> Saved (id, answer))
      | Failed _ ->
          []
      )
    (fun view state event ->
      match (state, event) with
      | Loading, Loaded (Ok issues) ->
          Go
            (Ready
               {
                 data = Linear_data.loaded issues;
                 reconnecting = false;
                 collapsed = [];
                 filter_open = false;
                 cursor = None;
                 menu_open = false;
                 toasts = [];
               }
            )
      | Loading, Loaded (Rejected message) ->
          Go (Failed message)
      | Loading, Loaded (Failed error) ->
          Go (Failed (Remote.error_to_string error))
      | Ready r, event ->
          ready_event view r event
      | Failed _, Retry ->
          Go Loading
      | (Loading | Failed _), _ ->
          Ignore
    )

let text = Node.text

let row cursor (issue : Issue.t) =
  Node.keyed
    (string_of_int issue.number)
    <li class_="border-b border-ui-border">
      (Router.link routes (Issue issue.number)
         ([
            Attr.ref_ (row_ref issue.number);
            Attr.string "id" ("issue-row-" ^ string_of_int issue.number);
            Attr.on_focus (Row_focused issue.number);
            Attr.string "class"
              "flex items-center gap-3 px-2 py-2 hover:bg-ui-highlight \
               focus:outline-2 focus:outline-ui-focus \
               data-cursor:bg-ui-highlight";
          ]
         @
         if cursor = Some issue.number then
           [ Attr.string "data-cursor" "" ]
         else
           []
         )
         [
           <span class_="w-16 shrink-0 text-sm text-ui-muted">
             (text (Issue.identifier issue))
           </span>;
           text " ";
           <span
             class_=(Class.join
                       [
                         "grow truncate";
                         ( if Issue_status.is_closed issue.status then
                             "text-ui-muted line-through"
                           else
                             ""
                         );
                       ]
                    )>
             (text issue.title)
           </span>;
           text " ";
           <span class_="shrink-0 text-sm text-ui-muted">
             (text (Issue_status.label issue.status))
           </span>;
         ]
      )
    </li>

let section (r : ready) (group, members) =
  let rows = <ul>(Node.list (List.map (row r.cursor) members))</ul> in
  match group with
  | Linear_view.All ->
      rows
  | group ->
      let key = Linear_view.group_key group in
      let open_ = not (List.mem group r.collapsed) in
      Node.keyed key
        <section class_="mb-2">
          <button
            id=("group-" ^ key)
            type_=`button
            aria_expanded=open_
            class_="flex w-full items-center gap-2 rounded-ui bg-ui-highlight \
                    px-2 py-1 text-left text-sm font-medium"
            on_press=(Toggle_group group)>
            (text (Linear_view.group_label group ^ " "))
            <span class_="text-ui-muted">
              (text (string_of_int (List.length members)))
            </span>
          </button>
          ( if open_ then
              rows
            else
              Node.list []
          )
        </section>

let select_items names label =
  List.map
    (fun (value, v) ->
      { Silica_ui.Select.value; label = label v; disabled = false }
    )
    names

let grouping_label = function
  | Linear_view.By_status ->
      "Status"
  | By_assignee ->
      "Assignee"
  | By_priority ->
      "Priority"
  | No_grouping ->
      "No grouping"

let ordering_label = function
  | Linear_view.Priority_order ->
      "Priority"
  | Updated ->
      "Last updated"
  | Created ->
      "Created"

let toolbar (view : Linear_view.t) (r : ready) =
  <div class_="mb-4 flex flex-wrap items-center gap-2">
    (Linear_filter.make ~open_:r.filter_open
       ~on_open_change:(fun open_ _ -> Filter_open open_)
       ~on_change:(fun filter -> Filter_changed filter)
       view.filter
    )
    (Silica_ui.Select.make
       ~on_value_change:(fun name -> Grouping_picked name)
       (Silica_ui.Select.props ~id:"issue-grouping" ~label:"Grouping"
          ~value:(Linear_view.name_of Linear_view.grouping_names view.grouping)
          ~classes:Silica_ui.Style.select
          (select_items Linear_view.grouping_names grouping_label)
       )
    )
    (Silica_ui.Select.make
       ~on_value_change:(fun name -> Ordering_picked name)
       (Silica_ui.Select.props ~id:"issue-ordering" ~label:"Ordering"
          ~value:(Linear_view.name_of Linear_view.ordering_names view.ordering)
          ~classes:Silica_ui.Style.select
          (select_items Linear_view.ordering_names ordering_label)
       )
    )
  </div>

let view (view : Linear_view.t) : state -> event Node.t = function
  | Loading ->
      <section id="issue-list">
        <h1 class_="mb-4 text-xl font-semibold" dataSilicaRouteFocus="">
          "Issues"
        </h1>
        <p class_="text-ui-muted">"Loading issues..."</p>
      </section>
  | Failed message ->
      <section id="issue-list">
        <h1 class_="mb-4 text-xl font-semibold" dataSilicaRouteFocus="">
          "Issues"
        </h1>
        <p role=`alert class_="text-ui-danger">(text message)</p>
        <button
          id="issues-retry"
          class_="mt-2 rounded-ui border border-ui-border px-3 py-1"
          on_press=Retry>
          "Try again"
        </button>
      </section>
  | Ready r ->
      let groups = Linear_view.groups view (Linear_data.issues r.data) in
      <section id="issue-list">
        <h1 class_="mb-4 text-xl font-semibold" dataSilicaRouteFocus="">
          "Issues"
        </h1>
        (toolbar view r)
        ( if r.data.stale then
            <p id="issues-offline" class_="mb-2 text-sm text-warning">
              "Offline. Showing the last issues received. "
              <button class_="underline" on_press=Reconnect>"Reconnect"</button>
            </p>
          else
            Node.list []
        )
        ( if groups = [] then
            <p id="issues-empty" class_="text-ui-muted">
              "No issues match the filter."
            </p>
          else
            Node.list (List.map (section r) groups)
        )
        (Linear_commands.make ~open_:r.menu_open
           ~on_open_change:(fun opened -> Menu_open opened)
           ~on_run:(fun value -> Command value)
           ~issues:(Linear_data.issues r.data)
           ~focused:
             (Option.bind r.cursor (fun number -> Linear_data.find number r.data)
             )
        )
        (Silica_ui.Toast.make
           ~on_close:(fun key -> Toast_closed key)
           (Silica_ui.Toast.props ~id:"list-toasts"
              ~classes:Silica_ui.Style.toast r.toasts
           )
        )
      </section>

let component = Component.make_with_props machine view
let make ?key ~view () = Component.node_with_props ?key ~props:view component
