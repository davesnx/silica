open Silica
open Jsonkit.Primitives
open Linear_model

type ready = { viewer : User.t; comments : Comment.t list } [@@deriving json]

type event =
  | Loaded of (Thread.t, string) Silica_jsonkit.answer
  | Updated of Comments.t Silica_jsonkit.update
  | Retry
[@@deriving json]

let event_name = function
  | Loaded answer ->
      answer_name "loaded" answer
  | Updated _ ->
      "updated"
  | Retry ->
      "retry"

type state = Loading | Ready of ready | Failed [@@deriving json]

let name = function
  | Loading ->
      "loading"
  | Ready _ ->
      "ready"
  | Failed ->
      "failed"

let states = [ "loading"; "ready"; "failed" ]

let machine =
  Machine.make_with_props ~id:"comments" ~init:Loading ~name ~states ~event_name
    ~during:(fun number -> function
      | Loading ->
          [ Remote.call comments_endpoint number (fun answer -> Loaded answer) ]
      | Ready _ ->
          [
            Topic.subscribe comments_topic (string_of_int number) (fun update ->
                Updated update
            );
          ]
      | Failed ->
          []
      )
    ~on_props:(fun previous _ _ ->
      match previous with Some _ -> Reenter Loading | None -> Ignore
    )
    (fun _ state event ->
      match (state, event) with
      | Loading, Loaded (Ok thread) ->
          Go (Ready { viewer = thread.viewer; comments = thread.comments })
      | Loading, Loaded (Rejected _ | Failed _) ->
          Go Failed
      | Ready r, Updated { seq; status = Status.Ready { data; _ } } when seq > 0
        ->
          Go (Ready { r with comments = data })
      | Ready _, Updated _ ->
          Stay []
      | Failed, Retry ->
          Go Loading
      | _ ->
          Ignore
    )

let text = Node.text

let view number state : event Node.t =
  <section id="comments" class_="mt-8">
    <h2 class_="mb-2 font-semibold">"Comments"</h2>
    ( match state with
    | Loading ->
        <p class_="text-ui-muted">"Loading comments..."</p>
    | Failed ->
        <div>
          <p role=`alert class_="text-ui-danger">
            "Could not load the comments."
          </p>
          <button id="comments-retry" class_="underline" on_press=Retry>
            "Try again"
          </button>
        </div>
    | Ready r ->
        <div>
          ( match r.comments with
          | [] ->
              <p id="comments-empty" class_="text-sm text-ui-muted">
                "No comments yet."
              </p>
          | comments ->
              <ul>
                (Node.list
                   (List.map
                      (fun (comment : Comment.t) ->
                        Linear_comment.make ~key:(string_of_int comment.id)
                          ~comment
                          ~own:(comment.author = r.viewer)
                          ()
                      )
                      comments
                   )
                )
              </ul>
          )
          <Linear_composer number />
        </div>
    )
  </section>

let component = Component.make_with_props machine view
let make ?key ~number () =
  Component.node_with_props ?key ~props:number component
