open Silica
open Linear_model

type event = Loaded of (User.t, Remote.error) result

module States = struct
  type _ t = Loading : unit t | Ready : User.t t | Failed : unit t
end

module Me_machine = Machine.Make (States)

let machine =
  Me_machine.make ~id:"me" ~init:(Me_machine.at Loading ())
    [
      Me_machine.state Loading "loading" ~to_:[ Ready; Failed ]
        ~invoke:[ Source.call me_endpoint Fun.id (fun r -> Loaded r) ]
        (fun () -> function
          | Loaded (Ok user) ->
              Me_machine.goto Ready user
          | Loaded (Error _) ->
              Me_machine.goto Failed ()
          );
      Me_machine.state Ready "ready" ~final:true Me_machine.ignore;
      Me_machine.state Failed "failed" ~final:true Me_machine.ignore;
    ]

let text = Node.text

let view (snapshot : Me_machine.snapshot) : event Node.t =
  match snapshot with
  | Me_machine.At (Loading, ()) ->
      <p id="me" class_="text-sm text-ui-muted">"..."</p>
  | Me_machine.At (Ready, user) ->
      <p id="me" class_="text-sm text-ui-muted">
        (text ("you are " ^ User.name user))
      </p>
  | Me_machine.At (Failed, ()) ->
      <p id="me" class_="text-sm text-ui-muted">"you are nobody"</p>

let component = Component.make machine view
let make ?key () = Component.node ?key component
