open Silica
open Linear_model

type event = Loaded of (User.t, string) Remote.answer
type state = Loading | Ready of User.t | Failed [@@deriving state_shape]

let machine =
  Machine.make ~id:"me" ~init:Loading ~shape:state_shape
    ~final:(function Ready _ | Failed -> true | Loading -> false)
    ~owns:(function
      | Loading ->
          [ Remote.call me_endpoint () (fun answer -> Loaded answer) ]
      | Ready _ | Failed ->
          []
      )
    (fun state event ->
      match (state, event) with
      | Loading, Loaded (Ok user) ->
          Go (Ready user)
      | Loading, Loaded (Rejected _ | Failed _) ->
          Go Failed
      | (Ready _ | Failed), Loaded _ ->
          Ignore
    )

let text = Node.text

let view : state -> event Node.t = function
  | Loading ->
      <p id="me" class_="text-sm text-ui-muted">"..."</p>
  | Ready user ->
      <p id="me" class_="text-sm text-ui-muted">
        (text ("you are " ^ User.name user))
      </p>
  | Failed ->
      <p id="me" class_="text-sm text-ui-muted">"you are nobody"</p>

let component = Component.make machine view
let make ?key () = Component.node ?key component
