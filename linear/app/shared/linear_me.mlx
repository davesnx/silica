open Silica
open Jsonkit.Primitives
open Linear_model

type event = Loaded of (User.t, string) Silica_jsonkit.answer
[@@deriving json]

let event_name (Loaded answer) = answer_name "loaded" answer

type state = Loading | Ready of User.t | Failed [@@deriving json, fingerprint]

let name = function
  | Loading ->
      "loading"
  | Ready _ ->
      "ready"
  | Failed ->
      "failed"

let states = [ "loading"; "ready"; "failed" ]

let machine =
  Machine.make ~id:"me" ~init:Loading ~name ~states ~event_name
    ~fingerprint:state_fingerprint
    ~final:(function Ready _ | Failed -> true | Loading -> false)
    ~during:(function
      | Loading ->
          [ Remote.call me_endpoint () (fun answer -> Loaded answer) ]
      | Ready _ | Failed ->
          []
      )
    (fun state event ->
      match (state, event) with
      | Loading, Loaded (Ok user) ->
          Go (Ready user)
      | Loading, Loaded (Rejected _ | Failed _) ->
          Go Failed
      | (Ready _ | Failed), Loaded _ ->
          Ignore
    )

let text = Node.text

let view : state -> event Node.t = function
  | Loading ->
      <p id="me" class_="text-sm text-ui-muted">"..."</p>
  | Ready user ->
      <p id="me" class_="text-sm text-ui-muted">
        (text ("you are " ^ User.name user))
      </p>
  | Failed ->
      <p id="me" class_="text-sm text-ui-muted">"you are nobody"</p>

let component = Component.make machine view
let make ?key () = Component.node ?key component
