open Silica
open Linear_model

type props = { comment : Comment.t; own : bool }

type event =
  | Edit
  | Typed of string
  | Save
  | Cancel
  | Saved of (Comment.t, string) Remote.answer

type editing = { draft : string; error : string option }

type state =
  | Viewing
  | Editing of editing
  | Saving of string
  | Edited of Comment.t
[@@deriving state_shape]

let input_ref id = Ref.make ("comment-" ^ string_of_int id ^ "-input")

let editing (props : props) draft error : (state, event) Machine.next =
  Go_with
    (Editing { draft; error }, [ Action.Focus (input_ref props.comment.id) ])

let machine =
  Machine.make_with_props ~id:"comment" ~init:Viewing ~shape:state_shape
    ~owns:(fun props -> function
      | Saving body ->
          [
            Remote.call edit_comment_endpoint
              { Comment_edit.id = props.comment.id; body } (fun answer ->
                Saved answer
            );
          ]
      | Viewing | Editing _ | Edited _ ->
          []
      )
    ~on_props:(fun _ props state ->
      match state with
      | Edited _ ->
          Go Viewing
      | (Editing _ | Saving _) when not props.own ->
          Go Viewing
      | Viewing | Editing _ | Saving _ ->
          Ignore
    )
    (fun props state event ->
      match (state, event) with
      | Viewing, Edit when props.own ->
          editing props props.comment.body None
      | Edited comment, Edit when props.own ->
          editing props comment.body None
      | Editing _, Typed draft ->
          Go (Editing { draft; error = None })
      | Editing e, Save -> (
          match Comment.check e.draft with
          | Ok body ->
              Go (Saving body)
          | Error message ->
              Go (Editing { e with error = Some message })
        )
      | Editing _, Cancel ->
          Go Viewing
      | Saving _, Saved (Ok comment) ->
          Go (Edited comment)
      | Saving body, Saved (Rejected message) ->
          editing props body (Some message)
      | Saving body, Saved (Failed _) ->
          editing props body (Some "Could not save the comment. Try again.")
      | _ ->
          Ignore
    )

let text = Node.text

let keys key =
  if Key.equal key Key.escape then
    Some Cancel
  else if
    Key.equal key (Key.make ~ctrl:true "Enter")
    || Key.equal key (Key.make ~meta:true "Enter")
  then
    Some Save
  else
    None

let header (comment : Comment.t) =
  <p class_="text-xs text-ui-muted">
    (text
       (User.name comment.author ^ " on "
       ^ Linear_data.date_of_epoch comment.created_at
       ^
       if comment.edited then
         " (edited)"
       else
         ""
       )
    )
  </p>

let base id = "comment-" ^ string_of_int id

let editor ~busy (props : props) draft error =
  let id = base props.comment.id in
  <div class_="flex flex-col gap-2">
    <textarea
      ref=(input_ref props.comment.id)
      id=(id ^ "-input")
      aria_label="Edit comment"
      rows=3
      class_="w-full rounded-ui border border-ui-border bg-ui-surface px-2 py-1"
      value=draft
      disabled=busy
      on_input=(fun value -> Typed value)
      on_key_down=keys
    />
    ( match error with
    | Some message ->
        <p role=`alert class_="text-sm text-ui-danger">(text message)</p>
    | None ->
        Node.list []
    )
    <div class_="flex gap-2">
      <button
        id=(id ^ "-save")
        type_=`button
        disabled=busy
        class_="rounded-ui bg-ui-accent px-3 py-1 text-sm text-ui-accent-text"
        on_press=Save>
        ( if busy then
            text "Saving..."
          else
            text "Save"
        )
      </button>
      <button
        id=(id ^ "-cancel")
        type_=`button
        disabled=busy
        class_="rounded-ui px-3 py-1 text-sm"
        on_press=Cancel>
        "Cancel"
      </button>
    </div>
  </div>

let shown (props : props) (comment : Comment.t) =
  let id = base comment.id in
  <li id class_="border-b border-ui-border py-2">
    (header comment)
    <p class_="whitespace-pre-wrap">(text comment.body)</p>
    ( if props.own then
        <button
          id=(id ^ "-edit")
          type_=`button
          class_="text-xs text-ui-muted underline"
          on_press=Edit>
          "Edit"
        </button>
      else
        Node.list []
    )
  </li>

let view (props : props) : state -> event Node.t = function
  | Viewing ->
      shown props props.comment
  | Edited comment ->
      shown props comment
  | Editing e ->
      <li id=(base props.comment.id) class_="py-2">
        (header props.comment) (editor ~busy:false props e.draft e.error)
      </li>
  | Saving body ->
      <li id=(base props.comment.id) class_="py-2">
        (header props.comment) (editor ~busy:true props body None)
      </li>

let component = Component.make_with_props machine view

let make ?key ~comment ~own () =
  Component.node_with_props ?key ~props:{ comment; own } component
