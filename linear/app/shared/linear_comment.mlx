open Silica
open Linear_model

type props = { comment : Comment.t; own : bool }

type event =
  | Props of props
  | Edit
  | Typed of string
  | Save
  | Cancel
  | Saved of (Comment.t, Remote.error) result

type editing = { props : props; draft : string; error : string option }

module States = struct
  type _ t =
    | Idle : unit t
    | Viewing : props t
    | Editing : editing t
    | Saving : (props * string) t
end

module Comment_machine = Machine.Make (States)

let input_ref id = Ref.make ("comment-" ^ string_of_int id ^ "-input")

let editing props draft error =
  Comment_machine.goto Editing { props; draft; error }
    ~actions:[ Action.Focus (input_ref props.comment.id) ]

let machine =
  Comment_machine.make ~id:"comment"
    ~init:(Comment_machine.at Idle ())
    [
      Comment_machine.state Idle "idle" ~to_:[ Viewing ] (fun () -> function
        | Props props ->
            Comment_machine.goto Viewing props
        | _ ->
            Comment_machine.unhandled
        );
      Comment_machine.state Viewing "viewing" ~to_:[ Editing ]
        (fun props -> function
        | Props props ->
            Comment_machine.goto Viewing props
        | Edit when props.own ->
            editing props props.comment.body None
        | _ ->
            Comment_machine.unhandled
        );
      Comment_machine.state Editing "editing" ~to_:[ Saving; Viewing ]
        (fun e -> function
        | Props props when not props.own ->
            Comment_machine.goto Viewing props
        | Props props ->
            Comment_machine.goto Editing { e with props }
        | Typed draft ->
            Comment_machine.goto Editing { e with draft; error = None }
        | Save -> (
            match Comment.check e.draft with
            | Ok body ->
                Comment_machine.goto Saving (e.props, body)
            | Error message ->
                Comment_machine.goto Editing { e with error = Some message }
          )
        | Cancel ->
            Comment_machine.goto Viewing e.props
        | _ ->
            Comment_machine.unhandled
        );
      Comment_machine.state Saving "saving" ~to_:[ Viewing; Editing ]
        ~invoke:
          [
            Source.call edit_comment_endpoint
              (fun ((props : props), body) ->
                { Comment_edit.id = props.comment.id; body }
              )
              (fun r -> Saved r);
          ]
        (fun (props, body) -> function
          | Props props when not props.own ->
              Comment_machine.goto Viewing props
          | Props props ->
              Comment_machine.goto Saving (props, body)
          | Saved (Ok comment) ->
              Comment_machine.goto Viewing { props with comment }
          | Saved (Error _) ->
              editing props body (Some "Could not save the comment. Try again.")
          | _ ->
              Comment_machine.unhandled
          );
    ]

let text = Node.text

let keys key =
  if Key.equal key Key.escape then
    Some Cancel
  else if
    Key.equal key (Key.make ~ctrl:true "Enter")
    || Key.equal key (Key.make ~meta:true "Enter")
  then
    Some Save
  else
    None

let header (comment : Comment.t) =
  <p class_="text-xs text-ui-muted">
    (text
       (User.name comment.author ^ " on "
       ^ Linear_data.date_of_epoch comment.created_at
       ^
       if comment.edited then
         " (edited)"
       else
         ""
       )
    )
  </p>

let base id = "comment-" ^ string_of_int id

let editor ~busy (props : props) draft error =
  let id = base props.comment.id in
  <div class_="flex flex-col gap-2">
    <textarea
      ref=(input_ref props.comment.id)
      id=(id ^ "-input")
      aria_label="Edit comment"
      rows=3
      class_="w-full rounded-ui border border-ui-border bg-ui-surface px-2 py-1"
      value=draft
      disabled=busy
      on_input=(fun value -> Typed value)
      on_key_down=keys
    />
    ( match error with
    | Some message ->
        <p role=`alert class_="text-sm text-ui-danger">(text message)</p>
    | None ->
        Node.list []
    )
    <div class_="flex gap-2">
      <button
        id=(id ^ "-save")
        type_=`button
        disabled=busy
        class_="rounded-ui bg-ui-accent px-3 py-1 text-sm text-ui-accent-text"
        on_press=Save>
        ( if busy then
            text "Saving..."
          else
            text "Save"
        )
      </button>
      <button
        id=(id ^ "-cancel")
        type_=`button
        disabled=busy
        class_="rounded-ui px-3 py-1 text-sm"
        on_press=Cancel>
        "Cancel"
      </button>
    </div>
  </div>

let view (snapshot : Comment_machine.snapshot) : event Node.t =
  match snapshot with
  | Comment_machine.At (Idle, ()) ->
      Node.list []
  | Comment_machine.At (Viewing, props) ->
      let id = base props.comment.id in
      <li id class_="border-b border-ui-border py-2">
        (header props.comment)
        <p class_="whitespace-pre-wrap">(text props.comment.body)</p>
        ( if props.own then
            <button
              id=(id ^ "-edit")
              type_=`button
              class_="text-xs text-ui-muted underline"
              on_press=Edit>
              "Edit"
            </button>
          else
            Node.list []
        )
      </li>
  | Comment_machine.At (Editing, e) ->
      <li id=(base e.props.comment.id) class_="py-2">
        (header e.props.comment) (editor ~busy:false e.props e.draft e.error)
      </li>
  | Comment_machine.At (Saving, (props, body)) ->
      <li id=(base props.comment.id) class_="py-2">
        (header props.comment) (editor ~busy:true props body None)
      </li>

let component = Component.make machine view

let make ?key ~comment ~own () =
  Component.node ?key ~props:(Props { comment; own }) component
