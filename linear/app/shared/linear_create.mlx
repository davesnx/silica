open Silica
open Jsonkit.Primitives
open Linear_model
open Linear_routes

type form = { draft : Draft.t; error : string option } [@@deriving json]

type event =
  | Title of string
  | Description of string
  | Status_picked of Issue_status.t
  | Priority_picked of Priority.t
  | Submit
  | Cancel
  | Created of (Issue.t, string) Silica_jsonkit.answer
[@@deriving json]

let event_name = function
  | Title _ ->
      "title"
  | Description _ ->
      "description"
  | Status_picked _ ->
      "status_picked"
  | Priority_picked _ ->
      "priority_picked"
  | Submit ->
      "submit"
  | Cancel ->
      "cancel"
  | Created answer ->
      answer_name "created" answer

type state =
  | Closed
  | Editing of form
  | Submitting of Draft.t
  | Failed of { draft : Draft.t; message : string }
[@@deriving json, fingerprint]

let name = function
  | Closed ->
      "closed"
  | Editing _ ->
      "editing"
  | Submitting _ ->
      "submitting"
  | Failed _ ->
      "failed"

let states = [ "closed"; "editing"; "submitting"; "failed" ]

let fresh = Editing { draft = Draft.empty; error = None }
let focus_opener = Action.Focus Linear_refs.new_issue

let close (route : issues) =
  [ Router.replace routes (Issues { route with create = false }); focus_opener ]

let edited (draft : Draft.t) = function
  | Title title ->
      Some { draft with title }
  | Description description ->
      Some { draft with description }
  | Status_picked status ->
      Some { draft with status }
  | Priority_picked priority ->
      Some { draft with priority }
  | Submit | Cancel | Created _ ->
      None

let machine =
  Machine.make_with_props ~id:"create-issue" ~init:Closed ~name ~states
    ~event_name ~fingerprint:state_fingerprint
    ~during:(fun _ -> function
      | Submitting draft ->
          [ Remote.call create_endpoint draft (fun answer -> Created answer) ]
      | Closed | Editing _ | Failed _ ->
          []
      )
    ~on_props:(fun _ (route : issues) state ->
      match (state, route.create) with
      | Closed, true ->
          Go fresh
      | (Editing _ | Failed _), false ->
          Go_with (Closed, [ focus_opener ])
      | Closed, false | (Editing _ | Failed _), true | Submitting _, _ ->
          Ignore
    )
    (fun route state event ->
      match (state, event) with
      | Editing form, Submit -> (
          match Draft.check form.draft with
          | Ok draft ->
              Go (Submitting draft)
          | Error message ->
              Go (Editing { form with error = Some message })
        )
      | Failed { draft; _ }, Submit ->
          Go (Submitting draft)
      | (Editing _ | Failed _), Cancel ->
          Go_with (Closed, close route)
      | Editing form, event -> (
          match edited form.draft event with
          | Some draft ->
              Go (Editing { draft; error = None })
          | None ->
              Ignore
        )
      | Failed { draft; _ }, event -> (
          match edited draft event with
          | Some draft ->
              Go (Editing { draft; error = None })
          | None ->
              Ignore
        )
      | Submitting _, Created (Ok _) ->
          Go_with (Closed, close route)
      | Submitting draft, Created (Rejected message) ->
          Go (Failed { draft; message })
      | Submitting draft, Created (Failed error) ->
          Go (Failed { draft; message = Remote.error_to_string error })
      | (Closed | Submitting _), _ ->
          Ignore
    )

let text = Node.text

let input_class =
  "w-full rounded-ui border border-ui-border bg-ui-surface px-2 py-1"

let option_of ~selected label =
  <option value=label selected>(text label)</option>

let status_select (draft : Draft.t) ~disabled =
  <select
    id="new-issue-status"
    aria_label="Status"
    class_=input_class
    disabled
    on_input=(fun value ->
               match Issue_status.of_label value with
               | Some status ->
                   Status_picked status
               | None ->
                   Status_picked draft.status
             )>
    (Node.list
       (List.map
          (fun status ->
            option_of ~selected:(status = draft.status)
              (Issue_status.label status)
          )
          Issue_status.all
       )
    )
  </select>

let priority_select (draft : Draft.t) ~disabled =
  <select
    id="new-issue-priority"
    aria_label="Priority"
    class_=input_class
    disabled
    on_input=(fun value ->
               match Priority.of_label value with
               | Some priority ->
                   Priority_picked priority
               | None ->
                   Priority_picked draft.priority
             )>
    (Node.list
       (List.map
          (fun priority ->
            option_of
              ~selected:(priority = draft.priority)
              (Priority.label priority)
          )
          Priority.all
       )
    )
  </select>

type content = { draft : Draft.t; busy : bool; message : string option }

let form { draft; busy; message } : event Node.t =
  <form
    on_submit=Submit
    on_key_down=(fun key ->
                  if
                    Key.equal key (Key.make ~ctrl:true "Enter")
                    || Key.equal key (Key.make ~meta:true "Enter")
                  then
                    Some Submit
                  else
                    None
                )
    class_="mt-3 flex flex-col gap-3">
    <input
      ref=Linear_refs.title
      id="new-issue-title"
      type_=`text
      aria_label="Title"
      placeholder="Issue title"
      class_=input_class
      value=draft.title
      disabled=busy
      on_input=(fun value -> Title value)
    />
    <textarea
      id="new-issue-description"
      aria_label="Description"
      placeholder="Description"
      rows=4
      class_=input_class
      value=draft.description
      disabled=busy
      on_input=(fun value -> Description value)
    />
    <div class_="flex gap-3">
      (status_select draft ~disabled:busy) (priority_select draft ~disabled:busy)
    </div>
    ( match message with
    | Some message ->
        <p id="new-issue-error" role=`alert class_="text-sm text-ui-danger">
          (text message)
        </p>
    | None ->
        Node.list []
    )
    <div class_="flex justify-end gap-2">
      <button
        type_=`button
        id="new-issue-cancel"
        class_="rounded-ui px-3 py-1 text-ui-muted"
        disabled=busy
        on_press=Cancel>
        "Cancel"
      </button>
      <button
        type_=`submit
        id="new-issue-submit"
        class_="rounded-ui bg-ui-accent px-3 py-1 text-ui-accent-text \
                disabled:opacity-50"
        disabled=busy>
        ( if busy then
            text "Creating..."
          else
            text "Create issue"
        )
      </button>
    </div>
  </form>

let dialog_component =
  Silica_ui.Dialog.component ~id:"create-issue-dialog"
    ~closes:(fun (_ : event) -> false)
    ~event_name form

let classes : Silica_ui.Dialog.classes =
  {
    Silica_ui.Dialog.no_classes with
    backdrop = "fixed inset-0 z-40 bg-ui-backdrop";
    popup =
      "fixed left-1/2 top-24 z-50 w-full max-w-lg -translate-x-1/2 rounded-lg \
       bg-ui-raised p-4 shadow-ui outline-none";
    title = "text-lg font-semibold";
  }

let dialog ~busy ~message draft =
  Silica_ui.Dialog.make
    ~on_open_change:(fun _ _ -> Cancel)
    ~on_content:Fun.id dialog_component
    (Silica_ui.Dialog.props ~id:"create-issue" ~title:"New issue" ~open_:true
       ~dismissible:(not busy) ~classes { draft; busy; message }
    )

let closed_dialog =
  Silica_ui.Dialog.make
    ~on_open_change:(fun _ _ -> Cancel)
    ~on_content:Fun.id dialog_component
    (Silica_ui.Dialog.props ~id:"create-issue" ~title:"New issue" ~open_:false
       ~classes
       { draft = Draft.empty; busy = false; message = None }
    )

let trigger (route : issues) =
  Router.link routes
    (Issues { route with create = true })
    [
      Attr.ref_ Linear_refs.new_issue;
      Attr.string "id" "new-issue";
      Attr.string "class"
        "rounded-ui bg-ui-accent px-3 py-1 text-sm text-ui-accent-text \
         hover:opacity-90";
    ]
    [ text "New issue" ]

let view route state : event Node.t =
  <div>
    (trigger route)
    ( match state with
    | Closed ->
        closed_dialog
    | Editing form ->
        dialog ~busy:false ~message:form.error form.draft
    | Submitting draft ->
        dialog ~busy:true ~message:None draft
    | Failed { draft; message } ->
        dialog ~busy:false
          ~message:(Some ("Could not create the issue. " ^ message))
          draft
    )
  </div>

let component = Component.make_with_props machine view
let make ?key ~route () = Component.node_with_props ?key ~props:route component
