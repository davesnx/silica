open Silica

type event = Attempt of Nav.t | Discard | Keep

let event_name = function
  | Attempt (Nav.Push _) ->
      "attempt push"
  | Attempt (Nav.Replace _) ->
      "attempt replace"
  | Attempt (Nav.Traverse _) ->
      "attempt traverse"
  | Discard ->
      "discard"
  | Keep ->
      "keep"

type state = Held | Asking of Nav.t

let name = function Held -> "held" | Asking _ -> "asking"
let states = [ "held"; "asking" ]

let keep_button = Ref.make "unsaved-keep"

let machine =
  Machine.make ~id:"unsaved" ~init:Held ~name ~states ~event_name
    ~during:(fun _ -> [ Source.block (fun nav -> Attempt nav) ])
    (fun state event ->
      match (state, event) with
      | (Held | Asking _), Attempt nav ->
          Go_with (Asking nav, [ Action.Focus keep_button ])
      | Asking nav, Discard ->
          Go_with (Held, [ Action.Resume nav ])
      | Asking _, Keep ->
          Go Held
      | Held, (Discard | Keep) ->
          Ignore
    )

let view : state -> event Node.t = function
  | Asking _ ->
      <div
        id="unsaved"
        role=`alertdialog
        aria_labelledby="unsaved-text"
        class_="mb-4 flex flex-wrap items-center gap-2 rounded-ui border \
                border-warning bg-warning-surface px-3 py-2 text-sm">
        <p id="unsaved-text" class_="grow">
          "You have unsaved changes. Leave this page?"
        </p>
        <button
          id="unsaved-discard"
          type_=`button
          class_="rounded-ui bg-ui-danger px-3 py-1 text-ui-surface"
          on_press=Discard>
          "Discard"
        </button>
        <button
          ref=keep_button
          id="unsaved-keep"
          type_=`button
          class_="rounded-ui px-3 py-1 text-ui-muted"
          on_press=Keep>
          "Keep editing"
        </button>
      </div>
  | Held ->
      Node.list []

let component = Component.make machine view

let make ?key ~on_keep () =
  Component.node ?key component ~output:(fun event _ ->
      match event with Keep -> [ on_keep ] | Attempt _ | Discard -> []
  )
