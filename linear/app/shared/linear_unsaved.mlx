open Silica

type event = Attempt of Nav.t | Discard | Keep

module States = struct
  type _ t = Held : unit t | Asking : Nav.t t
end

module Unsaved_machine = Machine.Make (States)

let keep_button = Ref.make "unsaved-keep"
let block () = Source.block (fun nav -> Attempt nav)
let ask nav =
  Unsaved_machine.goto Asking ~actions:[ Action.Focus keep_button ] nav

let machine =
  Unsaved_machine.make ~id:"unsaved"
    ~init:(Unsaved_machine.at Held ())
    [
      Unsaved_machine.state Held "held" ~to_:[ Asking ]
        ~invoke:[ block () ]
        (fun () -> function
          | Attempt nav -> ask nav | Discard | Keep -> Unsaved_machine.unhandled
          );
      Unsaved_machine.state Asking "asking" ~to_:[ Held ]
        ~invoke:[ block () ]
        (fun nav -> function
          | Attempt nav ->
              ask nav
          | Discard ->
              Unsaved_machine.goto Held ~actions:[ Action.Resume nav ] ()
          | Keep ->
              Unsaved_machine.goto Held ()
          );
    ]

let view (snapshot : Unsaved_machine.snapshot) : event Node.t =
  match snapshot with
  | Unsaved_machine.At (Asking, _) ->
      <div
        id="unsaved"
        role=`alertdialog
        aria_labelledby="unsaved-text"
        class_="mb-4 flex flex-wrap items-center gap-2 rounded-ui border \
                border-warning bg-warning-surface px-3 py-2 text-sm">
        <p id="unsaved-text" class_="grow">
          "You have unsaved changes. Leave this page?"
        </p>
        <button
          id="unsaved-discard"
          type_=`button
          class_="rounded-ui bg-ui-danger px-3 py-1 text-ui-surface"
          on_press=Discard>
          "Discard"
        </button>
        <button
          ref=keep_button
          id="unsaved-keep"
          type_=`button
          class_="rounded-ui px-3 py-1 text-ui-muted"
          on_press=Keep>
          "Keep editing"
        </button>
      </div>
  | Unsaved_machine.At (Held, ()) ->
      Node.list []

let component = Component.make machine view

let make ?key ~on_keep () =
  Component.node ?key component ~output:(fun event _ ->
      match event with Keep -> [ on_keep ] | Attempt _ | Discard -> []
  )
