open Silica
open Linear_model

type event =
  | Typed of string
  | Send
  | Clear
  | Sent of (Comment.t, string) Remote.answer

type state =
  | Empty
  | Drafting of string
  | Sending of string
  | Failed of { body : string; message : string }
[@@deriving state_shape]

let typed draft : (state, event) Machine.next =
  if String.trim draft = "" then
    Go Empty
  else
    Go (Drafting draft)

let machine =
  Machine.make_with_props ~id:"comment-composer" ~init:Empty ~shape:state_shape
    ~owns:(fun number -> function
      | Sending body ->
          [
            Remote.call add_comment_endpoint { New_comment.number; body }
              (fun answer -> Sent answer
            );
          ]
      | Empty | Drafting _ | Failed _ ->
          []
      )
    ~on_props:(fun previous _ _ ->
      match previous with Some _ -> Go Empty | None -> Ignore
    )
    (fun _ state event ->
      match (state, event) with
      | (Empty | Drafting _ | Failed _), Typed draft ->
          typed draft
      | Drafting draft, Send -> (
          match Comment.check draft with
          | Ok body ->
              Go (Sending body)
          | Error _ ->
              Go Empty
        )
      | Failed { body; _ }, Send ->
          Go (Sending body)
      | Empty, Clear ->
          Stay []
      | (Drafting _ | Failed _), Clear ->
          Go Empty
      | Sending _, Sent (Ok _) ->
          Go Empty
      | Sending body, Sent (Rejected message) ->
          Go (Failed { body; message })
      | Sending body, Sent (Failed error) ->
          Go (Failed { body; message = Remote.error_to_string error })
      | _ ->
          Ignore
    )

let text = Node.text

let keys key =
  if Key.equal key Key.escape then
    Some Clear
  else if
    Key.equal key (Key.make ~ctrl:true "Enter")
    || Key.equal key (Key.make ~meta:true "Enter")
  then
    Some Send
  else
    None

let form ~draft ~busy ~can_send ~message =
  <div id="comment-composer" class_="mt-4 flex flex-col gap-2">
    <textarea
      id="comment-input"
      aria_label="Comment"
      placeholder="Leave a comment"
      rows=3
      class_="w-full rounded-ui border border-ui-border bg-ui-surface px-2 py-1"
      value=draft
      disabled=busy
      on_input=(fun value -> Typed value)
      on_key_down=keys
    />
    ( match message with
    | Some message ->
        <p role=`alert class_="text-sm text-ui-danger">(text message)</p>
    | None ->
        Node.list []
    )
    <div>
      <button
        id="comment-send"
        type_=`button
        disabled=(not can_send)
        class_="rounded-ui bg-ui-accent px-3 py-1 text-sm text-ui-accent-text \
                disabled:opacity-50"
        on_press=Send>
        ( if busy then
            text "Sending..."
          else
            text "Comment"
        )
      </button>
    </div>
  </div>

let view : state -> event Node.t = function
  | Empty ->
      form ~draft:"" ~busy:false ~can_send:false ~message:None
  | Drafting draft ->
      form ~draft ~busy:false ~can_send:true ~message:None
  | Sending draft ->
      form ~draft ~busy:true ~can_send:false ~message:None
  | Failed { body; message } ->
      form ~draft:body ~busy:false ~can_send:true
        ~message:(Some ("Could not send the comment. " ^ message))

let component = Component.make machine view
let make ?key ~number () =
  Component.node_with_props ?key ~props:number component
