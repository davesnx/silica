(library
 (name silica_site_server)
 (wrapped false)
 (modules site_docs_pages site_llms site_server)
 (libraries silica_site_app_native silica.server silica.adapter unix))

(executable
 (name main)
 (modules main)
 (libraries
  silica_site_server
  silica.server
  silica.server-kit
  silica.adapter))

(rule
 (target site_docs_pages.ml)
 (deps
  (glob_files %{project_root}/docs/*.mld)
  %{project_root}/docs/glossary.mld
  (source_tree %{project_root}/docs/examples)
  (glob_files %{project_root}/example/app/shared/*)
  %{project_root}/example/app/native/dune
  %{project_root}/example/app/melange/dune
  (glob_files %{project_root}/linear/app/shared/*)
  (glob_files %{project_root}/linear/client/*.{ml,css})
  (glob_files %{project_root}/linear/server/*.ml)
  (glob_files %{project_root}/skills/silica-verify/references/api/*.md))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../gen/docs_gen.exe} pages %{project_root}/docs))))

(rule
 (targets llms.txt llms-full.txt site_llms.ml)
 (deps
  (glob_files %{project_root}/docs/*.mld)
  %{project_root}/docs/glossary.mld
  (source_tree %{project_root}/docs/examples)
  (glob_files %{project_root}/example/app/shared/*)
  %{project_root}/example/app/native/dune
  %{project_root}/example/app/melange/dune
  (glob_files %{project_root}/linear/app/shared/*)
  (glob_files %{project_root}/linear/client/*.{ml,css})
  (glob_files %{project_root}/linear/server/*.ml))
 (action
  (progn
   (with-stdout-to
    llms.txt
    (run
     %{exe:../gen/llms.exe}
     index
     https://silica-site.fly.dev
     %{project_root}/docs))
   (with-stdout-to
    llms-full.txt
    (run
     %{exe:../gen/llms.exe}
     full
     https://silica-site.fly.dev
     %{project_root}/docs
     %{project_root}/skills/silica-verify/references/api/silica.md
     %{project_root}/skills/silica-verify/references/api/check.md
     %{project_root}/skills/silica-verify/references/api/memory.md
     %{project_root}/skills/silica-verify/references/api/server.md
     %{project_root}/skills/silica-verify/references/api/ui.md))
   (with-stdout-to
    site_llms.ml
    (run
     %{exe:../gen/llms.exe}
     ml
     https://silica-site.fly.dev
     %{project_root}/docs
     %{project_root}/skills/silica-verify/references/api/silica.md
     %{project_root}/skills/silica-verify/references/api/check.md
     %{project_root}/skills/silica-verify/references/api/memory.md
     %{project_root}/skills/silica-verify/references/api/server.md
     %{project_root}/skills/silica-verify/references/api/ui.md)))))
