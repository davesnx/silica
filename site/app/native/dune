(copy_files ../shared/*.{ml,mlx})

(copy_files ../../stories/*.mlx)

(library
 (name silica_site_app_native)
 (wrapped false)
 (modes native)
 (libraries
  silica
  silica-ui
  silica.jsonkit
  jsonkit
  silica_docs_examples_native)
 (preprocess
  (pps jsonkit.ppx silica.ppx)))

(rule
 (target site_docs_index.ml)
 (deps
  (glob_files %{project_root}/docs/*.mld)
  %{project_root}/docs/glossary.mld
  (source_tree %{project_root}/docs/examples)
  (glob_files %{project_root}/example/app/shared/*)
  %{project_root}/example/app/native/dune
  %{project_root}/example/app/melange/dune
  (glob_files %{project_root}/linear/app/shared/*)
  (glob_files %{project_root}/linear/client/*.{ml,css})
  (glob_files %{project_root}/linear/server/*.ml))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../../gen/docs_gen.exe} index %{project_root}/docs))))

(rule
 (target site_story_sources.ml)
 (deps
  (glob_files ../../stories/*.mlx))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../../gen/embed_gen.exe} %{deps}))))

