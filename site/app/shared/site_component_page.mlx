open Silica
open Silica_ui

type values = (string * Story.values) list
type event = Set of string * Story.values [@@deriving event_shape]
type state = Idle | Shown of values [@@deriving state_shape]

let fresh slug =
  match Site_catalog.find slug with
  | Some entry ->
      List.map (fun (_, s) -> (Story.slug s, Story.defaults s)) entry.stories
  | None ->
      []

let machine =
  Machine.make_with_props ~id:"component-page" ~init:Idle ~shape:state_shape
    ~events:event_shape
    ~on_props:(fun previous slug _ ->
      if previous = Some slug then
        Ignore
      else
        Go (Shown (fresh slug))
    )
    (fun _ state event ->
      match (state, event) with
      | Shown values, Set (story, story_values) when List.mem_assoc story values
        ->
          Go
            (Shown
               (List.map
                  (fun (s, v) ->
                    if s = story then
                      (s, story_values)
                    else
                      (s, v)
                  )
                  values
               )
            )
      | Shown _, Set _ ->
          Stay []
      | Idle, Set _ ->
          Ignore
    )

let section_heading ~slug ~anchor text =
  <h2
    id=anchor
    class_="group mb-4 scroll-mt-24 text-xl font-semibold tracking-tight">
    (Node.text (text ^ " "))
    (Site_links.component
       ~attrs:
         [
           Attr.string "class"
             "ml-1 text-ui-muted opacity-0 group-hover:opacity-100 \
              focus-visible:opacity-100";
           Attr.string "aria-label" ("Link to " ^ text);
         ]
       slug
       [ Node.text "#" ]
    )
  </h2>

let chart_view chart =
  <div
    class_="overflow-x-auto rounded-ui border border-ui-border bg-ui-raised \
            p-4 [&>div]:mx-0">
    (Site_chart.view chart)
  </div>

let story_view ~(entry : Site_catalog.entry) values (file, (story : Story.t)) =
  let anchor = Story.slug story in
  let id = entry.info.slug ^ "-" ^ anchor in
  let values =
    Option.value (List.assoc_opt anchor values) ~default:(Story.defaults story)
  in
  Node.element "section"
    [ Attr.string "class" "mt-14"; Attr.string "data-story" anchor ]
    [
      section_heading ~slug:entry.info.slug ~anchor story.name;
      <div class_="overflow-hidden rounded-ui border border-ui-border">
        <div
          class_=( if story.controls = [] then
                     "grid"
                   else
                     "grid md:grid-cols-[minmax(0,1fr)_15rem]"
                 )>
          <div
            class_="story-preview flex min-h-48 items-center justify-center \
                    bg-ui-raised p-8">
            (Story.render ~id story values)
          </div>
          ( match story.controls with
          | [] ->
              Node.list []
          | _ ->
              <div
                class_="border-t border-ui-border p-4 md:border-t-0 md:border-l">
                (Story.controls ~id:(id ^ "-control") story values (fun v ->
                     Set (anchor, v)
                 )
                )
              </div>
          )
        </div>
        <div
          class_="border-t border-ui-border [&>figure]:my-0 \
                  [&>figure]:rounded-none [&>figure]:border-0">
          (let code =
             Site_code.view ~file:("site/stories/" ^ file) ~lang:"mlx"
               story.source
           in
           if List.length (String.split_on_char '\n' story.source) <= 30 then
             code
           else
             <details class_="group">
               <summary
                 class_="cursor-pointer px-4 py-2 text-sm text-ui-muted \
                         hover:text-ui-text">
                 (Node.text
                    ("Show the source ("
                    ^ string_of_int
                        (List.length (String.split_on_char '\n' story.source))
                    ^ " lines)"
                    )
                 )
               </summary>
               code
             </details>
          )
        </div>
      </div>;
    ]

let themes_view (entry : Site_catalog.entry) =
  match entry.grid with
  | None ->
      Node.list []
  | Some story ->
      <section class_="mt-16">
        (section_heading ~slug:entry.info.slug ~anchor:"themes" "In every theme")
        <p class_="mb-4 text-ui-muted">
          (Node.text
             ("The story \"" ^ story.name
            ^ "\" in each shipped theme, side by side, with Theme.scope. \
               Popups that open from a scope use its theme."
             )
          )
        </p>
        <div id="theme-grid" class_="grid gap-4 sm:grid-cols-2">
          (Node.list
             (List.map
                (fun theme ->
                  Theme.scope theme
                    [
                      <div
                        class_="flex flex-col gap-4 rounded-ui border \
                                border-ui-border p-4">
                        <p class_="text-xs font-medium text-ui-muted">
                          (Node.text (Theme.label theme))
                        </p>
                        <div class_="flex min-h-32 items-center justify-center">
                          (Story.render
                             ~id:(entry.info.slug ^ "-theme-" ^ Theme.name theme)
                             story (Story.defaults story)
                          )
                        </div>
                      </div>;
                    ]
                )
                Site_theme.themes
             )
          )
        </div>
      </section>

let view slug state : event Node.t =
  match state with
  | Idle ->
      <div />
  | Shown values -> (
      match Site_catalog.find slug with
      | None ->
          <div>
            (Node.element "h1"
               [
                 Attr.bool "data-silica-route-focus" true;
                 Attr.string "class" "text-4xl font-semibold tracking-tight";
               ]
               [ Node.text "No such component" ]
            )
            <p class_="mt-4">"Pick a component from the list."</p>
          </div>
      | Some entry ->
          <div class_="min-w-0">
            (Node.element "h1"
               [
                 Attr.bool "data-silica-route-focus" true;
                 Attr.string "class"
                   "text-4xl font-semibold tracking-tight outline-none";
               ]
               [ Node.text entry.info.name ]
            )
            <p class_="mt-3 max-w-[65ch] text-lg leading-8 text-ui-muted">
              (Node.text entry.info.summary)
            </p>
            <p class_="mt-3 font-mono text-sm text-ui-muted">
              (Node.text entry.info.modules)
            </p>
            ( match entry.chart with
            | Some chart ->
                <section class_="mt-12">
                  (section_heading ~slug:entry.info.slug ~anchor:"statechart"
                     "Statechart"
                  )
                  <p class_="mb-4 max-w-[65ch] text-ui-muted">
                    (Node.text
                       ("The states of the machine " ^ chart.machine
                      ^ " and the events that move it, as the checker run in \
                         test/ui_check found them."
                       )
                    )
                  </p>
                  (chart_view chart)
                </section>
            | None ->
                Node.list []
            )
            (Node.list (List.map (story_view ~entry values) entry.stories))
            (themes_view entry)
          </div>
    )

let component = Component.make_with_props machine view
let make ?key ~slug () = Component.node_with_props ?key ~props:slug component
let page slug : Silica.Router.event Node.t = make ~slug ()
