open Silica
open Jsonkit.Primitives

type event = Loaded of (Site_doc.answer, string) Silica_jsonkit.answer | Retry
[@@deriving json, event_shape]

type state = Loading | Ready of Site_doc.page | Missing | Failed of string
[@@deriving json, state_shape]

let machine =
  Machine.make_with_props ~id:"doc-page" ~init:Loading ~shape:state_shape
    ~events:event_shape
    ~owns:(fun slug -> function
      | Loading ->
          [ Remote.call Site_doc.endpoint slug (fun answer -> Loaded answer) ]
      | Ready _ | Missing | Failed _ ->
          []
      )
    ~on_props:(fun previous slug _ ->
      match previous with
      | Some previous when previous <> slug ->
          Reenter Loading
      | _ ->
          Ignore
    )
    (fun _ state event ->
      match (state, event) with
      | Loading, Loaded (Ok (Site_doc.Page page)) ->
          Go (Ready page)
      | Loading, Loaded (Ok Site_doc.Missing) ->
          Go Missing
      | Loading, Loaded (Rejected reason) ->
          Go (Failed reason)
      | Loading, Loaded (Failed error) ->
          Go (Failed (Remote.error_to_string error))
      | Failed _, Retry ->
          Go Loading
      | _ ->
          Ignore
    )

let pager slug =
  let before, after = Site_nav.neighbours slug in
  let card ~rel ~caption target =
    match Option.bind target Site_nav.title with
    | None ->
        <div />
    | Some title ->
        Site_links.doc
          ~attrs:
            [
              Attr.string "rel" rel;
              Attr.string "class"
                ("flex flex-col gap-1 rounded-ui border border-ui-border px-4 \
                  py-3 hover:bg-ui-highlight "
                ^
                if rel = "next" then
                  "items-end text-right"
                else
                  ""
                );
            ]
          (Option.get target)
          [
            <span class_="text-xs text-ui-muted">(Node.text caption)</span>;
            Node.text " ";
            <span class_="font-medium">(Node.text title)</span>;
          ]
  in
  <nav
    aria_label="Previous and next pages"
    class_="mt-16 grid grid-cols-2 gap-4 border-t border-ui-border pt-6">
    (card ~rel:"prev" ~caption:"Previous" before)
    (card ~rel:"next" ~caption:"Next" after)
  </nav>

let toc slug blocks =
  match Site_markup.toc blocks with
  | [] ->
      Node.list []
  | entries ->
      <nav
        aria_label="On this page"
        class_="sticky top-20 hidden max-h-[calc(100vh-6rem)] overflow-y-auto \
                text-sm xl:block">
        <p class_="mb-3 font-semibold">"On this page"</p>
        <ul class_="space-y-2 border-l border-ui-border">
          (Node.list
             (List.map
                (fun (level, anchor, text) ->
                  <li>
                    (Site_links.doc ~hash:anchor
                       ~attrs:
                         [
                           Attr.string "class"
                             ( if level = 1 then
                                 "-ml-px block border-l border-transparent \
                                  pl-3 text-ui-muted hover:border-ui-text \
                                  hover:text-ui-text"
                               else
                                 "-ml-px block border-l border-transparent \
                                  pl-6 text-ui-muted hover:border-ui-text \
                                  hover:text-ui-text"
                             );
                         ]
                       slug
                       [ Node.text text ]
                    )
                  </li>
                )
                entries
             )
          )
        </ul>
      </nav>

let article slug title body =
  <div class_="grid gap-12 xl:grid-cols-[minmax(0,1fr)_14rem]">
    <article id="doc" class_="min-w-0 max-w-[72ch]">
      (Node.element "h1"
         [
           Attr.bool "data-silica-route-focus" true;
           Attr.string "class"
             "text-4xl font-semibold tracking-tight text-balance outline-none";
         ]
         [ Node.text title ]
      )
      body
      (pager slug)
    </article>
    <div />
  </div>

let view slug state : event Node.t =
  match state with
  | Loading ->
      article slug
        (Option.value (Site_nav.title slug) ~default:"Loading")
        <p class_="mt-6 text-ui-muted" aria_busy=true>"Loading the page."</p>
  | Ready page ->
      <div class_="grid gap-12 xl:grid-cols-[minmax(0,1fr)_14rem]">
        <article id="doc" class_="min-w-0 max-w-[72ch]">
          (Node.element "h1"
             [
               Attr.bool "data-silica-route-focus" true;
               Attr.string "class"
                 "text-4xl font-semibold tracking-tight text-balance \
                  outline-none";
             ]
             [ Node.text page.title ]
          )
          (Site_markup.blocks ~slug:page.slug page.blocks)
          (pager page.slug)
        </article>
        (toc page.slug page.blocks)
      </div>
  | Missing ->
      article slug "Page not found"
        <p class_="mt-6">
          "There is no documentation page with this name. Pick one from the \
           list."
        </p>
  | Failed reason ->
      article slug "This page did not load"
        <div class_="mt-6 flex flex-col items-start gap-3">
          <p class_="text-ui-danger">(Node.text reason)</p>
          <button
            type_=`button
            class_="rounded-ui bg-ui-accent px-3 py-1.5 text-sm \
                    text-ui-accent-text"
            on_press=Retry>
            "Try again"
          </button>
        </div>

let component = Component.make_with_props machine view
let make ?key ~slug () = Component.node_with_props ?key ~props:slug component
