open Silica
open Silica_ui

type nothing = |

let help_dialog =
  Dialog.component ~id:"help-dialog"
    ~closes:(function (_ : nothing) -> .)
    (fun () -> <p class_="mt-2 text-sm">"A name has at most 40 letters."</p>)

type rename = { name : string }
type rename_event = Name of string | Save

let rename_view { name } =
  <form on_submit=Save class_="mt-3 flex flex-col gap-2">
    <input
      id="rename-name"
      aria_label="Name"
      class_="rounded-ui border border-ui-border bg-ui-surface px-2 py-1"
      value=name
      on_input=(fun value -> Name value)
    />
    (Select.make
       (Select.props ~id:"case" ~label:"Letter case" ~value:"typed" ~name:"case"
          ~classes:Style.select
          [
            { Select.value = "typed"; label = "As typed"; disabled = false };
            { Select.value = "upper"; label = "Upper case"; disabled = false };
          ]
       )
    )
    <div class_="flex gap-2">
      <button type_=`submit id="rename-save" class_=Style.button>"Save"</button>
      (Dialog.make help_dialog
         (Dialog.props ~id:"help" ~title:"Help" ~trigger:"Help" ~close:"Got it"
            ~classes:Style.dialog ()
         )
      )
    </div>
  </form>

let rename_dialog =
  Dialog.component ~id:"rename-dialog"
    ~closes:(function Save -> true | Name _ -> false)
    rename_view

type page = {
  name : string;
  saved : string;
  events : string list;
  open_ : bool option;
}

type event =
  | Changed of bool * Popup.reason
  | Edited of rename_event
  | Open_from_outside
[@@deriving event_shape]

let note page line = { page with events = page.events @ [ line ] }

let machine =
  Machine.make ~id:"dialog-events"
    ~init:{ name = "Ada"; saved = "Ada"; events = []; open_ = None }
    ~shape:(Machine.shape ~name:(fun _ -> "page") ())
    ~events:event_shape
    (fun page event ->
      match event with
      | Changed (opened, reason) ->
          Go
            (note
               { page with open_ = Some opened }
               (Printf.sprintf "%s %s"
                  ( if opened then
                      "open"
                    else
                      "close"
                  )
                  (Popup.reason_name reason)
               )
            )
      | Edited (Name name) ->
          Go { page with name }
      | Edited Save ->
          Go (note { page with saved = page.name } "save")
      | Open_from_outside ->
          Go (note { page with open_ = Some true } "open from outside")
    )

let view page =
  <section class_="flex flex-col gap-4">
    <p id="saved">(Node.text ("Name: " ^ page.saved))</p>
    <div class_="flex gap-2">
      (Dialog.make
         ~on_open_change:(fun opened reason -> Changed (opened, reason))
         ~on_content:(fun event -> Edited event)
         rename_dialog
         (Dialog.props ~id:"rename" ~title:"Rename"
            ~description:"Choose the name that the page shows."
            ~trigger:"Rename" ~close:"Cancel" ?open_:page.open_
            ~classes:Style.dialog
            ({ name = page.name } : rename)
         )
      )
      <button
        type_=`button
        id="open-outside"
        class_="rounded-ui border border-ui-border px-3 py-1 text-sm"
        on_press=Open_from_outside>
        "Open from outside"
      </button>
    </div>
    <ol id="event-log" class_="text-sm text-ui-muted">
      (Node.list (List.map (fun line -> <li>(Node.text line)</li>) page.events))
    </ol>
  </section>

let component = Component.make machine view
let render ~id:_ _ = Component.node component
