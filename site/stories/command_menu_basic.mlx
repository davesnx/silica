open Silica
open Silica_ui

let commands =
  Combobox.
    [
      item ~keywords:[ "create" ] "new-file" "New file";
      item "open-file" "Open file";
      item ~disabled:true "share" "Share";
      item ~keywords:[ "quit" ] "close" "Close window";
    ]

type event = Open | Changed of bool

let machine =
  Machine.make_with_props ~id:"command-menu-basic" ~init:None
    ~name:(fun _ -> "page")
    (fun _ _ event ->
      match event with
      | Open ->
          Go (Some true)
      | Changed opened ->
          Go (Some opened)
    )

let view id open_ =
  <div>
    <button type_=`button class_=Style.button on_press=Open>
      "Open commands"
    </button>
    (Command_menu.make
       ~on_open_change:(fun opened _ -> Changed opened)
       (Command_menu.props ~id ~title:"Commands" ~placeholder:"Type a command"
          ~empty:"No command found" ?open_ ~classes:Style.command_menu commands
       )
    )
  </div>

let component = Component.make_with_props machine view
let render ~id _values = Component.node_with_props ~props:id component
