open Silica
open Silica_ui

type label = { label : string }
type label_event = Label of string | Save

let label_view { label } =
  <form on_submit=Save class_="mt-2 flex flex-col gap-2">
    <input
      id="label-name"
      aria_label="Label"
      class_="rounded-ui border border-ui-border bg-ui-surface px-2 py-1"
      value=label
      on_input=(fun value -> Label value)
    />
    <button type_=`submit id="label-save" class_=Style.button>"Save"</button>
  </form>

let label_popover =
  Popover.component ~id:"label-popover"
    ~closes:(function Save -> true | Label _ -> false)
    label_view

type nothing = |

let info_popover =
  Popover.component ~id:"info-popover"
    ~closes:(function (_ : nothing) -> .)
    (fun () ->
      <p class_="mt-1 text-sm">
        "Popovers flip to the other side when there is no room."
      </p>
    )

type page = { label : string; saved : string; events : string list }
type event = Changed of bool * Popup.reason | Edited of label_event
[@@deriving event_shape]

let note page line = { page with events = page.events @ [ line ] }

let machine =
  Machine.make ~id:"popover-events"
    ~init:{ label = "Bug"; saved = "Bug"; events = [] }
    ~shape:(Machine.shape ~name:(fun _ -> "page") ())
    ~events:event_shape
    (fun page event ->
      match event with
      | Changed (opened, reason) ->
          Go
            (note page
               (Printf.sprintf "%s %s"
                  ( if opened then
                      "open"
                    else
                      "close"
                  )
                  (Popup.reason_name reason)
               )
            )
      | Edited (Label label) ->
          Go { page with label }
      | Edited Save ->
          Go (note { page with saved = page.label } "save")
    )

let changed opened reason = Changed (opened, reason)

let view page =
  <section class_="flex flex-col gap-4">
    <p id="saved">(Node.text ("Label: " ^ page.saved))</p>
    <div class_="flex gap-2 pt-36">
      (Popover.make ~on_open_change:changed
         ~on_content:(fun event -> Edited event)
         label_popover
         (Popover.props ~id:"label" ~trigger:"Edit label" ~title:"Edit label"
            ~close:"Close" ~classes:Style.popover
            ({ label = page.label } : label)
         )
      )
      (Popover.make info_popover
         (Popover.props ~id:"info" ~trigger:"Info" ~title:"Placement"
            ~place:{ Place.default with side = Place.Top }
            ~classes:Style.popover ()
         )
      )
    </div>
    <ol id="event-log" class_="text-sm text-ui-muted">
      (Node.list (List.map (fun line -> <li>(Node.text line)</li>) page.events))
    </ol>
  </section>

let component = Component.make machine view
let render ~id:_ _ = Component.node component
