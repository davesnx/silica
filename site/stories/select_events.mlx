open Silica
open Silica_ui

type page = { value : string option; events : string list }

type event = Changed of bool * Popup.reason | Value of string | Set_done

module States = struct
  type _ t = Page : page t
end

module M = Machine.Make (States)

let note page line = { page with events = page.events @ [ line ] }

let machine =
  M.make ~id:"select-events"
    ~init:(M.at Page { value = None; events = [] })
    [
      M.state Page "page" (fun page -> function
        | Changed (opened, reason) ->
            M.goto Page
              (note page
                 (Printf.sprintf "%s %s"
                    ( if opened then
                        "open"
                      else
                        "close"
                    )
                    (Popup.reason_name reason)
                 )
              )
        | Value value ->
            M.goto Page
              (note { page with value = Some value } ("value " ^ value))
        | Set_done ->
            M.goto Page { page with value = Some "done" }
        );
    ]

let item ?(disabled = false) value label = { Select.value; label; disabled }

let statuses =
  [
    item "backlog" "Backlog";
    item "todo" "Todo";
    item ~disabled:true "blocked" "Blocked";
    item "progress" "In progress";
    item "done" "Done";
    item "duplicate" "Duplicate";
  ]

let priorities =
  [ item "low" "Low"; item "medium" "Medium"; item "high" "High" ]

let view (M.At (Page, page)) =
  <section class_="flex flex-col gap-4">
    <p id="status-value">
      (Node.text ("Status: " ^ Option.value page.value ~default:"none"))
    </p>
    <form id="issue-form" class_="flex gap-2">
      (Select.make
         ~on_open_change:(fun opened reason -> Changed (opened, reason))
         ~on_value_change:(fun value -> Value value)
         (Select.props ~id:"status" ~label:"Status" ?value:page.value
            ~placeholder:"Pick a status" ~name:"status" ~classes:Style.select
            statuses
         )
      )
      (Select.make
         (Select.props ~id:"priority" ~label:"Priority" ~value:"medium"
            ~classes:Style.select priorities
         )
      )
      <button
        type_=`button
        id="after"
        class_="rounded-ui border border-ui-border px-3 py-1 text-sm">
        "After"
      </button>
    </form>
    <button
      type_=`button
      id="set-done"
      class_="self-start rounded-ui border border-ui-border px-3 py-1 text-sm"
      on_press=Set_done>
      "Set Done"
    </button>
    <ol id="events" class_="text-sm text-ui-muted">
      (Node.list (List.map (fun line -> <li>(Node.text line)</li>) page.events))
    </ol>
  </section>

let component = Component.make machine view
let render ~id:_ _ = Component.node component
