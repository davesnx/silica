open Silica
open Silica_ui

type props = { id : string; orientation : Tabs.orientation }
type event = Changed of string [@@deriving event_shape]

let machine =
  Machine.make_with_props ~id:"tabs-basic" ~init:"overview"
    ~shape:(Machine.shape ~name:(fun _ -> "page") ())
    ~events:event_shape
    (fun _ _ (Changed selected) -> Go selected)

let tabs =
  [
    Tabs.tab ~value:"overview" "Overview";
    Tabs.tab ~value:"activity" "Activity";
    Tabs.tab ~value:"files" ~disabled:true "Files";
    Tabs.tab ~value:"members" "Members";
  ]

let view { id; orientation } selected =
  let panel value text =
    Tabs.panel ~class_:Style.tab_panel ~id ~value ~selected [ Node.text text ]
  in
  let layout =
    if orientation = Tabs.Vertical then
      "flex gap-4"
    else
      "flex flex-col"
  in
  <div class_=layout>
    (Tabs.make
       ~on_value_change:(fun value -> Changed value)
       (Tabs.props ~id ~orientation ~value:selected ~classes:Style.tabs tabs)
    )
    <div>
      (panel "overview" "What the project is about.")
      (panel "activity" "The latest changes.")
      (panel "files" "No files yet.")
      (panel "members" "Who works on it.")
    </div>
  </div>

let component = Component.make_with_props machine view

let render ~id values =
  let orientation =
    if Story.string values "orientation" = "vertical" then
      Tabs.Vertical
    else
      Tabs.Horizontal
  in
  Component.node_with_props ~props:{ id; orientation } component
