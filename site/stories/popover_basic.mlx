open Silica
open Silica_ui

type nothing = |

let shipping_popover =
  Popover.component ~id:"shipping-popover"
    ~closes:(function (_ : nothing) -> .)
    (fun () -> <p class_="mt-1 text-sm">"Orders ship in two work days."</p>)

let side = function
  | "top" ->
      Place.Top
  | "left" ->
      Place.Left
  | "right" ->
      Place.Right
  | _ ->
      Place.Bottom

let render ~id values =
  Popover.make shipping_popover
    (Popover.props ~id ~trigger:"Shipping" ~title:"Shipping" ~close:"Close"
       ~open_:(Story.bool values "open")
       ~place:{ Place.default with side = side (Story.string values "side") }
       ~classes:Style.popover ()
    )
