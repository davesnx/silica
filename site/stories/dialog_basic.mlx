open Silica_ui

module Note = struct
  type props = unit
  type event = |

  let id = "delete-dialog"
  let view () = <p class_="mt-2 text-sm">"You cannot undo this."</p>
  let closes : event -> bool = function _ -> .
end

module Delete_dialog = Dialog.Make (Note)

let render ~id values =
  Delete_dialog.make
    (Delete_dialog.props ~id ~title:"Delete the draft?"
       ~description:"The draft and its notes go away." ~trigger:"Delete draft"
       ~close:"Cancel"
       ~dismissible:(Story.bool values "dismissible")
       ~alert:(Story.bool values "alert")
       ~classes:Style.dialog ()
    )
