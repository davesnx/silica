open Silica_ui

type nothing = |

let delete_dialog =
  Dialog.component ~id:"delete-dialog"
    ~closes:(function (_ : nothing) -> .)
    (fun () -> <p class_="mt-2 text-sm">"You cannot undo this."</p>)

let render ~id values =
  Dialog.make delete_dialog
    (Dialog.props ~id ~title:"Delete the draft?"
       ~description:"The draft and its notes go away." ~trigger:"Delete draft"
       ~close:"Cancel"
       ~dismissible:(Story.bool values "dismissible")
       ~alert:(Story.bool values "alert")
       ~classes:Style.dialog ()
    )
