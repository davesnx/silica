open Silica
open Silica_ui

type props = { id : string; priority : Toast.priority }
type page = { toasts : Toast.toast list; next : int }
type event = Add | Closed of string

let machine =
  Machine.make_with_props ~id:"toast-basic" ~init:{ toasts = []; next = 1 }
    ~shape:(Machine.shape ~name:(fun _ -> "page") ())
    (fun props page event ->
      match event with
      | Add ->
          let toast =
            Toast.toast ~key:(string_of_int page.next) ~priority:props.priority
              ~description:"The file is ready." "Export done"
          in
          Go { toasts = page.toasts @ [ toast ]; next = page.next + 1 }
      | Closed key ->
          Go
            {
              page with
              toasts =
                List.filter
                  (fun (toast : Toast.toast) -> toast.key <> key)
                  page.toasts;
            }
    )

let view props page =
  <div>
    <button type_=`button class_=Style.button on_press=Add>
      "Show a toast"
    </button>
    (Toast.make
       ~on_close:(fun key -> Closed key)
       (Toast.props ~id:props.id ~label:"Messages" ~classes:Style.toast
          page.toasts
       )
    )
  </div>

let component = Component.make_with_props machine view

let render ~id values =
  let priority =
    if Story.string values "priority" = "high" then
      Toast.High
    else
      Toast.Low
  in
  Component.node_with_props ~props:{ id; priority } component
