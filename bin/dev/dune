(library
 (name silica_dev)
 (libraries
  cmdliner
  unix
  threads.posix
  dune-rpc
  fiber
  stdune
  csexp
  ordering
  pp
  silica.json
  silica.server-kit))

(rule
 (target dev_client_script.ml)
 (deps %{project_root}/devtools/dist/silica-dev.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {silica_dev_client|")
    (cat %{deps})
    (echo "|silica_dev_client}\n")))))
