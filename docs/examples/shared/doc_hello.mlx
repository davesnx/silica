open Silica

type event = Answered of (string, Remote.error) result | Retry

module States = struct
  type _ t = Loading : unit t | Shown : string t | Failed : unit t
end

module Hello_machine = Machine.Make (States)

let machine =
  Hello_machine.make ~id:"hello"
    ~init:(Hello_machine.at Loading ())
    [
      Hello_machine.state Loading "loading" ~to_:[ Shown; Failed ]
        ~invoke:
          [
            Source.call Tutorial_api.greeting
              (fun () -> "Ada")
              (fun result -> Answered result);
          ]
        (fun () -> function
          | Answered (Ok text) ->
              Hello_machine.goto Shown text
          | Answered (Error _) ->
              Hello_machine.goto Failed ()
          | Retry ->
              Hello_machine.unhandled
          );
      Hello_machine.state Shown "shown" ~final:true Hello_machine.ignore;
      Hello_machine.state Failed "failed" ~to_:[ Loading ] (fun () -> function
        | Retry ->
            Hello_machine.goto Loading ()
        | Answered _ ->
            Hello_machine.unhandled
        );
    ]

let view (snapshot : Hello_machine.snapshot) : event Node.t =
  match snapshot with
  | Hello_machine.At (Loading, ()) ->
      <p>"Loading."</p>
  | Hello_machine.At (Shown, text) ->
      <p>(Node.text text)</p>
  | Hello_machine.At (Failed, ()) ->
      <div><p>"No answer."</p> <button on_press=Retry>"Try again"</button></div>

let component = Component.make machine view
