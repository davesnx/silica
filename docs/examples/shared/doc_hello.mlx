open Silica

type event = Answered of (string, string) Remote.answer | Retry
type state = Loading | Shown of string | Failed [@@deriving state_shape]

let machine =
  Machine.make ~id:"hello" ~init:Loading ~shape:state_shape
    ~final:(function Shown _ -> true | Loading | Failed -> false)
    ~owns:(function
      | Loading ->
          [
            Remote.call Tutorial_api.greeting "Ada" (fun answer ->
                Answered answer
            );
          ]
      | Shown _ | Failed ->
          []
      )
    (fun state event ->
      match (state, event) with
      | Loading, Answered (Ok text) ->
          Go (Shown text)
      | Loading, Answered (Rejected _ | Failed _) ->
          Go Failed
      | Failed, Retry ->
          Go Loading
      | _ ->
          Ignore
    )

let view : state -> event Node.t = function
  | Loading ->
      <p>"Loading."</p>
  | Shown text ->
      <p>(Node.text text)</p>
  | Failed ->
      <div><p>"No answer."</p> <button on_press=Retry>"Try again"</button></div>

let component = Component.make machine view
