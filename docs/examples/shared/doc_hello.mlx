open Silica

type event = Answered of (string, Remote.error) result | Retry

module States = struct
  type _ t = Loading : unit t | Shown : string t | Failed : unit t
end

module M = Machine.Make (States)

let machine =
  M.make ~id:"hello" ~init:(M.at Loading ())
    [
      M.state Loading "loading" ~to_:[ Shown; Failed ]
        ~invoke:
          [
            Source.call Tutorial_api.greeting
              (fun () -> "Ada")
              (fun result -> Answered result);
          ]
        (fun () -> function
          | Answered (Ok text) ->
              M.goto Shown text
          | Answered (Error _) ->
              M.goto Failed ()
          | Retry ->
              M.unhandled
          );
      M.state Shown "shown" ~final:true M.ignore;
      M.state Failed "failed" ~to_:[ Loading ] (fun () -> function
        | Retry ->
            M.goto Loading ()
        | Answered _ ->
            M.unhandled
        );
    ]

let view (snapshot : M.snapshot) : event Node.t =
  match snapshot with
  | M.At (Loading, ()) ->
      <p>"Loading."</p>
  | M.At (Shown, text) ->
      <p>(Node.text text)</p>
  | M.At (Failed, ()) ->
      <div><p>"No answer."</p> <button on_press=Retry>"Try again"</button></div>

let component = Component.make machine view
