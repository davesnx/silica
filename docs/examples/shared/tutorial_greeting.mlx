open Silica

type event = Ask | Answered of (string, string) Remote.answer
type state = Idle | Asking | Shown of string | Failed of string

let name = function
  | Idle ->
      "idle"
  | Asking ->
      "asking"
  | Shown _ ->
      "shown"
  | Failed _ ->
      "failed"

let machine =
  Machine.make ~id:"greeting" ~init:Idle ~name
    ~during:(function
      | Asking ->
          [
            Remote.call Tutorial_api.greeting "Ada" (fun answer ->
                Answered answer
            );
          ]
      | Idle | Shown _ | Failed _ ->
          []
      )
    (fun state event ->
      match (state, event) with
      | (Idle | Shown _ | Failed _), Ask ->
          Go Asking
      | Asking, Answered (Ok text) ->
          Go (Shown text)
      | Asking, Answered (Rejected reason) ->
          Go (Failed reason)
      | Asking, Answered (Failed error) ->
          Go (Failed (Remote.error_to_string error))
      | _ ->
          Ignore
    )

let view : state -> event Node.t = function
  | Idle ->
      <button on_press=Ask>"Say hello"</button>
  | Asking ->
      <p>"Asking the server."</p>
  | Shown text ->
      <div>
        <p>(Node.text text)</p> <button on_press=Ask>"Ask again"</button>
      </div>
  | Failed reason ->
      <div>
        <p>(Node.text reason)</p> <button on_press=Ask>"Try again"</button>
      </div>

let component = Component.make machine view
