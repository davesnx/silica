open Silica

type event = Up | Down
type state = Count of int

let name (Count _) = "count"

let machine =
  Machine.make_with_props ~id:"stepper" ~init:(Count 0) ~name
    (fun _label (Count count) event ->
      match event with
      | Up ->
          Go (Count (count + 1))
      | Down when count = 0 ->
          Stay []
      | Down ->
          Go (Count (count - 1))
  )

let view label (Count count) : event Node.t =
  <div>
    <span>(Node.text (label ^ ": " ^ string_of_int count))</span>
    <button aria_label=("Fewer " ^ label) on_press=Down disabled=(count = 0)>
      "-"
    </button>
    <button aria_label=("More " ^ label) on_press=Up>"+"</button>
  </div>

let component = Component.make_with_props machine view

let make ?key ~label ~on_change () =
  Component.node_with_props ?key component ~props:label
    ~output:(fun _ (Count count) -> [ on_change count ]
  )
