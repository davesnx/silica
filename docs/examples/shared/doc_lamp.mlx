open Silica

type event = Toggle [@@deriving event_shape]
type state = Off | On [@@deriving state_shape]

let machine =
  Machine.make ~id:"lamp" ~init:Off ~shape:state_shape ~events:event_shape
    (fun state Toggle -> match state with Off -> Go On | On -> Go Off
  )

let view : state -> event Node.t = function
  | Off ->
      <div>
        <p>"The lamp is off."</p> <button on_press=Toggle>"Turn on"</button>
      </div>
  | On ->
      <div>
        <p>"The lamp is on."</p> <button on_press=Toggle>"Turn off"</button>
      </div>

let component = Component.make machine view
