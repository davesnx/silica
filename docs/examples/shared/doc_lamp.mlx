open Silica

type event = Toggle

module States = struct
  type _ t = Off : unit t | On : unit t
end

module Lamp_machine = Machine.Make (States)

let machine =
  Lamp_machine.make ~id:"lamp" ~init:(Lamp_machine.at Off ())
    [
      Lamp_machine.state Off "off" ~to_:[ On ] (fun () Toggle ->
          Lamp_machine.goto On ()
      );
      Lamp_machine.state On "on" ~to_:[ Off ] (fun () Toggle ->
          Lamp_machine.goto Off ()
      );
    ]

let view (snapshot : Lamp_machine.snapshot) : event Node.t =
  match snapshot with
  | Lamp_machine.At (Off, ()) ->
      <div>
        <p>"The lamp is off."</p> <button on_press=Toggle>"Turn on"</button>
      </div>
  | Lamp_machine.At (On, ()) ->
      <div>
        <p>"The lamp is on."</p> <button on_press=Toggle>"Turn off"</button>
      </div>

let component = Component.make machine view
