open Silica

type event = Typed of string | Settle | Clear

type state = Empty | Typing of string | Settled of string
[@@deriving state_shape]

let typed : string -> (state, event) Machine.next = function
  | "" ->
      Go Empty
  | text ->
      Reenter (Typing text)

let machine =
  Machine.make ~id:"debounce" ~init:Empty ~shape:state_shape
    ~owns:(function
      | Typing _ -> [ Source.after 500 Settle ] | Empty | Settled _ -> []
      )
    (fun state event ->
      match (state, event) with
      | _, Typed text ->
          typed text
      | Typing text, Settle ->
          Go (Settled text)
      | _, Clear ->
          Go Empty
      | _ ->
          Ignore
    )

let view (state : state) : event Node.t =
  let text, note =
    match state with
    | Empty ->
        ("", "Type a word.")
    | Typing text ->
        (text, "Waiting for you to stop.")
    | Settled text ->
        (text, "You typed " ^ text ^ ".")
  in
  <div>
    <input aria_label="Word" value=text on_input=(fun text -> Typed text) />
    <button on_press=Clear disabled=(text = "")>"Clear"</button>
    <p>(Node.text note)</p>
  </div>

let component = Component.make machine view
