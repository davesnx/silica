open Silica

type event = Typed of string | Settle | Clear

module States = struct
  type _ t = Empty : unit t | Typing : string t | Settled : string t
end

module Debounce_machine = Machine.Make (States)

let typed = function
  | "" ->
      Debounce_machine.goto Empty ()
  | text ->
      Debounce_machine.reenter Typing text

let machine =
  Debounce_machine.make ~id:"debounce"
    ~init:(Debounce_machine.at Empty ())
    [
      Debounce_machine.state Empty "empty" ~to_:[ Typing ] (fun () -> function
        | Typed text ->
            typed text
        | Settle | Clear ->
            Debounce_machine.unhandled
        );
      Debounce_machine.state Typing "typing" ~to_:[ Empty; Settled ]
        ~after:[ (500, Settle) ]
        (fun text -> function
          | Typed text ->
              typed text
          | Settle ->
              Debounce_machine.goto Settled text
          | Clear ->
              Debounce_machine.unhandled
          );
      Debounce_machine.state Settled "settled" ~to_:[ Empty; Typing ]
        (fun _ -> function
        | Typed text ->
            typed text
        | Settle | Clear ->
            Debounce_machine.unhandled
        );
      Debounce_machine.always ~to_:[ Empty ] (function
        | Clear ->
            Debounce_machine.goto Empty ()
        | Typed _ | Settle ->
            Debounce_machine.unhandled
        );
    ]

let view (snapshot : Debounce_machine.snapshot) : event Node.t =
  let text, note =
    match snapshot with
    | Debounce_machine.At (Empty, ()) ->
        ("", "Type a word.")
    | Debounce_machine.At (Typing, text) ->
        (text, "Waiting for you to stop.")
    | Debounce_machine.At (Settled, text) ->
        (text, "You typed " ^ text ^ ".")
  in
  <div>
    <input aria_label="Word" value=text on_input=(fun text -> Typed text) />
    <button on_press=Clear disabled=(text = "")>"Clear"</button>
    <p>(Node.text note)</p>
  </div>

let component = Component.make machine view
