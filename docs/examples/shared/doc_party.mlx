open Silica

type party = { adults : int; children : int }
type event = Adults of int | Children of int
type state = Party of party [@@deriving state_shape]

let machine =
  Machine.make ~id:"party"
    ~init:(Party { adults = 0; children = 0 })
    ~shape:state_shape
    (fun (Party party) event ->
      match event with
      | Adults adults ->
          Go (Party { party with adults })
      | Children children ->
          Go (Party { party with children })
    )

let view (Party { adults; children }) : event Node.t =
  <div>
    <Doc_stepper key="adults" label="Adults" on_change=(fun n -> Adults n) />
    <Doc_stepper
      key="children" label="Children" on_change=(fun n -> Children n)
    />
    <p>(Node.text (string_of_int (adults + children) ^ " guests"))</p>
  </div>

let component = Component.make machine view
