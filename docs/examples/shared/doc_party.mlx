open Silica

type party = { adults : int; children : int }
type event = Adults of int | Children of int

module States = struct
  type _ t = Party : party t
end

module Party_machine = Machine.Make (States)

let machine =
  Party_machine.make ~id:"party"
    ~init:(Party_machine.at Party { adults = 0; children = 0 })
    [
      Party_machine.state Party "party" (fun party -> function
        | Adults adults ->
            Party_machine.goto Party { party with adults }
        | Children children ->
            Party_machine.goto Party { party with children }
        );
    ]

let view
    (Party_machine.At (Party, { adults; children }) : Party_machine.snapshot) :
    event Node.t =
  <div>
    <Doc_stepper key="adults" label="Adults" on_change=(fun n -> Adults n) />
    <Doc_stepper
      key="children" label="Children" on_change=(fun n -> Children n)
    />
    <p>(Node.text (string_of_int (adults + children) ^ " guests"))</p>
  </div>

let component = Component.make machine view
