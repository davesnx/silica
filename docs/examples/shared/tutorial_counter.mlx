open Silica

type event = Increment | Decrement

module States = struct
  type _ t = Count : int t
end

module Counter_machine = Machine.Make (States)

let machine =
  Counter_machine.make ~id:"counter"
    ~init:(Counter_machine.at Count 0)
    [
      Counter_machine.state Count "count" (fun n -> function
        | Increment ->
            Counter_machine.goto Count (n + 1)
        | Decrement when n = 0 ->
            Counter_machine.stay []
        | Decrement ->
            Counter_machine.goto Count (n - 1)
        );
    ]

let view (Counter_machine.At (Count, n) : Counter_machine.snapshot) :
    event Node.t =
  <div>
    <button on_press=Decrement disabled=(n = 0)>"Decrement"</button>
    <span>(Node.text (string_of_int n))</span>
    <button on_press=Increment>"Increment"</button>
  </div>

let component = Component.make machine view
