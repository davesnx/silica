open Silica

type event = Copy | Result of bool | Back

module States = struct
  type _ t = Ready : unit t | Shown : bool t
end

module Copy_machine = Machine.Make (States)

let text = "Hello from Silica"

let machine =
  Copy_machine.make ~id:"copy" ~init:(Copy_machine.at Ready ())
    [
      Copy_machine.state Ready "ready" ~to_:[ Shown ] (fun () -> function
        | Copy ->
            Copy_machine.stay
              [ Cmd.Copy { text; on_result = Some (fun ok -> Result ok) } ]
        | Result ok ->
            Copy_machine.goto Shown ok
        | Back ->
            Copy_machine.unhandled
        );
      Copy_machine.state Shown "shown" ~to_:[ Ready ]
        ~after:[ (2000, Back) ]
        (fun _ -> function
          | Back ->
              Copy_machine.goto Ready ()
          | Copy | Result _ ->
              Copy_machine.unhandled
          );
    ]

let view (snapshot : Copy_machine.snapshot) : event Node.t =
  match snapshot with
  | Copy_machine.At (Ready, ()) ->
      <div>
        <code>(Node.text text)</code>
        <button on_press=Copy>"Copy the text"</button>
      </div>
  | Copy_machine.At (Shown, true) ->
      <p>"Copied."</p>
  | Copy_machine.At (Shown, false) ->
      <p>"The browser did not allow the copy."</p>

let component = Component.make machine view
