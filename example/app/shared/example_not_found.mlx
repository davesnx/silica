open Silica
open Example_routes

type event = Url of string

module States = struct
  type _ t = Not_found : unit t
end

module Not_found_machine = Machine.Make (States)

let machine =
  Not_found_machine.make ~id:"not_found"
    ~init:(Not_found_machine.at Not_found ())
    [
      Not_found_machine.state Not_found "not_found"
        ~entry:(fun () -> [ Cmd.Set_title "Not found" ])
        Not_found_machine.ignore;
    ]

let view (_ : Not_found_machine.snapshot) : event Node.t =
  <div>
    <h1>"Not found"</h1>
    (Router.link routes State.Home () [] [ Node.text "Home" ])
  </div>

let component = Component.make machine view
let make ?key ~url () = Component.node ?key ~props:(Url url) component
