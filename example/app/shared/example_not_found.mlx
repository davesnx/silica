open Silica
open Example_routes

type state = Not_found [@@deriving fingerprint]

let name Not_found = "not_found"
let states = [ "not_found" ]

let machine =
  Machine.make ~id:"not_found" ~init:Not_found ~name ~states
    ~fingerprint:state_fingerprint
    ~final:(fun Not_found -> true)
    ~entry:(fun Not_found -> [ Action.Set_title "Not found" ])
    (fun Not_found () -> Ignore)

let view Not_found : unit Node.t =
  <div>
    <h1>"Not found"</h1> (Router.link routes Home [] [ Node.text "Home" ])
  </div>

let component = Component.make machine view
let make ?key () = Component.node ?key component
