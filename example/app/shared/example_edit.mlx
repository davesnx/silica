open Silica

type event = Draft of string | Attempt of Nav.t | Leave | Stay | Save

let event_name = function
  | Draft _ ->
      "draft"
  | Attempt _ ->
      "attempt"
  | Leave ->
      "leave"
  | Stay ->
      "stay"
  | Save ->
      "save"

type state = Clean | Dirty of string | Asking of string * Nav.t

let name = function
  | Clean ->
      "clean"
  | Dirty _ ->
      "dirty"
  | Asking _ ->
      "asking"

let states = [ "clean"; "dirty"; "asking" ]

let machine =
  Machine.make ~id:"edit" ~init:Clean ~name ~states ~event_name
    ~entry:(function Clean -> [ Action.Set_title "Edit" ] | _ -> [])
    ~during:(function
      | Clean ->
          []
      | Dirty _ | Asking _ ->
          [ Host.block (fun nav -> Attempt nav) ]
      )
    (fun state event ->
      match (state, event) with
      | Clean, Draft text when text <> "" ->
          Go (Dirty text)
      | Clean, Save ->
          Stay []
      | Dirty _, (Draft "" | Save) ->
          Go Clean
      | Dirty _, Draft text ->
          Go (Dirty text)
      | Dirty draft, Attempt nav ->
          Go (Asking (draft, nav))
      | Asking (_, nav), Leave ->
          Go_with (Clean, [ Action.Resume nav ])
      | Asking (draft, _), Stay ->
          Go (Dirty draft)
      | Asking (draft, _), Attempt next ->
          Go (Asking (draft, next))
      | Asking _, Save ->
          Stay []
      | _ ->
          Ignore
    )

let draft = function Clean -> "" | Dirty draft | Asking (draft, _) -> draft

let view (state : state) : event Node.t =
  <div>
    <h1>"Edit"</h1>
    (Example_nav.make ())
    <textarea
      aria_label="Draft" value=(draft state) on_input=(fun v -> Draft v)
    />
    <button on_press=Save>"Save"</button>
    ( match state with
    | Asking _ ->
        <div role=`alertdialog aria_label="Unsaved draft">
          <p>"Leave this page? The draft is not saved."</p>
          <button on_press=Leave>"Leave"</button>
          <button on_press=Stay>"Stay"</button>
        </div>
    | Clean | Dirty _ ->
        Node.list []
    )
  </div>

let component = Component.make machine view
let make ?key () = Component.node ?key component
