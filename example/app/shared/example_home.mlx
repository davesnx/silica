open Silica

type state = Home [@@deriving state_shape]

let machine =
  Machine.make ~id:"home" ~init:Home ~shape:state_shape
    ~final:(fun Home -> true)
    ~entry:(fun Home -> [ Action.Set_title "Silica example" ])
    (fun Home () -> Ignore)

let view Home : unit Node.t =
  <div>
    <h1>"Silica example"</h1>
    (Example_nav.make ())
    <Example_todo />
    <Example_votes />
    <Example_vote_button />
    <section><h2>"Live counter"</h2> (Live.slot Example_counter.live)</section>
  </div>

let component = Component.make machine view
let make ?key () = Component.node ?key component
