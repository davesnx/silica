open Silica
open Jsonkit.Primitives
open Example_model

type event = Settled of (Item.t, string) Silica_jsonkit.answer
[@@deriving json]

let event_name = function
  | Settled (Remote.Ok _) ->
      "settled ok"
  | Settled (Rejected _) ->
      "settled rejected"
  | Settled (Failed _) ->
      "settled error"

type state =
  | Loading
  | Loaded of Item.t
  | Missing of string
  | Failed of Silica_jsonkit.error
[@@deriving json]

let name = function
  | Loading ->
      "loading"
  | Loaded _ ->
      "loaded"
  | Missing _ ->
      "missing"
  | Failed _ ->
      "failed"

let states = [ "loading"; "loaded"; "missing"; "failed" ]

let machine =
  Machine.make_with_props ~id:"item" ~init:Loading ~name ~states ~event_name
    ~entry:(fun _ -> function
      | Loaded item ->
          [ Action.Set_title item.title ]
      | Loading | Missing _ | Failed _ ->
          [ Action.Set_title "Item" ]
      )
    ~during:(fun id -> function
      | Loading ->
          [ Remote.call item_endpoint id (fun answer -> Settled answer) ]
      | Loaded _ | Missing _ | Failed _ ->
          []
      )
    ~on_props:(fun previous id _ ->
      match previous with
      | Some previous when previous <> id ->
          Go Loading
      | Some _ | None ->
          Ignore
    )
    (fun _ state event ->
      match (state, event) with
      | Loading, Settled (Ok item) ->
          Go (Loaded item)
      | Loading, Settled (Rejected reason) ->
          Go (Missing reason)
      | Loading, Settled (Failed error) ->
          Go (Failed error)
      | _ ->
          Ignore
    )

let text = Node.text
let price cents = Printf.sprintf "$%d.%02d" (cents / 100) (cents mod 100)

let view id state : event Node.t =
  <div>
    <h1>"Item"</h1>
    (Example_nav.make ())
    ( match state with
    | Loading ->
        <p>(text (Printf.sprintf "Loading item %d..." id))</p>
    | Missing reason ->
        <p>(text reason)</p>
    | Failed error ->
        <p>(text (Remote.error_to_string error))</p>
    | Loaded item ->
        <article>
          <h2>(text item.title)</h2>
          <p>(text (price item.price_cents))</p>
          <ul>
            (Node.list (List.map (fun tag -> <li>(text tag)</li>) item.tags))
          </ul>
        </article>
    )
  </div>

let component = Component.make_with_props machine view
let make ?key ~id () = Component.node_with_props ?key ~props:id component
