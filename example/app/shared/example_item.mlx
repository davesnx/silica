open Silica
open Example_model

type event = Props of int | Settled of (Item.t, Remote.error) result

module States = struct
  type _ t =
    | Idle : unit t
    | Loading : int t
    | Loaded : Item.t t
    | Failed : Remote.error t
end

module Item_machine = Machine.Make (States)

let title text = [ Cmd.Set_title text ]

let machine =
  Item_machine.make ~id:"item" ~init:(Item_machine.at Idle ())
    [
      Item_machine.always ~to_:[ Loading ] (function
        | Props id ->
            Item_machine.reenter Loading id
        | Settled _ ->
            Item_machine.unhandled
        );
      Item_machine.state Idle "idle"
        ~entry:(fun () -> title "Item")
        Item_machine.ignore;
      Item_machine.state Loading "loading" ~to_:[ Loaded; Failed ]
        ~entry:(fun _ -> title "Item")
        ~invoke:[ Source.call item_endpoint Fun.id (fun r -> Settled r) ]
        (fun _ -> function
          | Settled (Ok item) ->
              Item_machine.goto Loaded item
          | Settled (Error error) ->
              Item_machine.goto Failed error
          | Props _ ->
              Item_machine.unhandled
          );
      Item_machine.state Loaded "loaded"
        ~entry:(fun (item : Item.t) -> title item.title)
        Item_machine.ignore;
      Item_machine.state Failed "failed"
        ~entry:(fun _ -> title "Item")
        Item_machine.ignore;
    ]

let text = Node.text
let price cents = Printf.sprintf "$%d.%02d" (cents / 100) (cents mod 100)

let error_text : Remote.error -> string = function
  | Http code ->
      "Server answered " ^ string_of_int code
  | Decode msg ->
      "Bad answer: " ^ msg
  | Network msg ->
      "Network error: " ^ msg

let view (snapshot : Item_machine.snapshot) : event Node.t =
  <div>
    <h1>"Item"</h1>
    (Example_nav.make ())
    ( match snapshot with
    | Item_machine.At (Idle, ()) ->
        <p>"Nothing loaded."</p>
    | Item_machine.At (Loading, id) ->
        <p>(text (Printf.sprintf "Loading item %d..." id))</p>
    | Item_machine.At (Failed, error) ->
        <p>(text (error_text error))</p>
    | Item_machine.At (Loaded, item) ->
        <article>
          <h2>(text item.title)</h2>
          <p>(text (price item.price_cents))</p>
          <ul>
            (Node.list (List.map (fun tag -> <li>(text tag)</li>) item.tags))
          </ul>
        </article>
    )
  </div>

let component = Component.make machine view
let make ?key ~id () = Component.node ?key ~props:(Props id) component
