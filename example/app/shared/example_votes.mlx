open Silica

type event = Update of int Topic.update | Reconnect

module States = struct
  type _ t = Watching : int Status.t t
end

module Votes_machine = Machine.Make (States)

let machine =
  Votes_machine.make ~id:"votes"
    ~init:(Votes_machine.at Watching Status.Idle)
    [
      Votes_machine.state Watching "watching"
        ~invoke:
          [
            Source.live Example_model.votes_topic
              (fun _ -> "main")
              (fun update -> Update update);
          ]
        (fun status -> function
          | Update { status; _ } ->
              Votes_machine.goto Watching status
          | Reconnect ->
              Votes_machine.reenter Watching status
          );
    ]

let text = Node.text

let view (Votes_machine.At (Watching, status) : Votes_machine.snapshot) :
    event Node.t =
  let count =
    match Status.data status with Some n -> string_of_int n | None -> "..."
  in
  <section id="votes">
    <h2>"Votes"</h2>
    <p>(text "Votes: ") <span id="votes-count">(text count)</span></p>
    ( if Status.is_stale status then
        <p id="votes-offline">"Offline, showing old data"</p>
      else
        Node.list []
    )
    ( match status with
    | Status.Failed _ ->
        <button id="votes-reconnect" on_press=Reconnect>"Reconnect"</button>
    | Status.Idle | Status.Loading _ | Status.Ready _ ->
        Node.list []
    )
  </section>

let component = Component.make machine view
let make ?key () = Component.node ?key component
