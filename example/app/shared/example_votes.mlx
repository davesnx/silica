open Silica

type event = Update of int Topic.update | Reconnect
type state = Watching of int Status.t [@@deriving state_shape]

let machine =
  Machine.make ~id:"votes" ~init:(Watching Status.Idle) ~shape:state_shape
    ~owns:(fun (Watching _) ->
      [
        Source.live Example_model.votes_topic "main" (fun update ->
            Update update
        );
      ]
    )
    (fun (Watching status) event ->
      match event with
      | Update { status; _ } ->
          Go (Watching status)
      | Reconnect ->
          Reenter (Watching status)
    )

let text = Node.text

let view (Watching status) : event Node.t =
  let count =
    match Status.data status with Some n -> string_of_int n | None -> "..."
  in
  <section id="votes">
    <h2>"Votes"</h2>
    <p>(text "Votes: ") <span id="votes-count">(text count)</span></p>
    ( if Status.is_stale status then
        <p id="votes-offline">"Offline, showing old data"</p>
      else
        Node.list []
    )
    ( match status with
    | Status.Failed _ ->
        <button id="votes-reconnect" on_press=Reconnect>"Reconnect"</button>
    | Status.Idle | Status.Loading _ | Status.Ready _ ->
        Node.list []
    )
  </section>

let component = Component.make machine view
let make ?key () = Component.node ?key component
