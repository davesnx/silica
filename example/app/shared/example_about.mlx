open Silica

type event = Go_back [@@deriving json]
type state = About [@@deriving json, fingerprint]

let name About = "about"
let states = [ "about" ]
let event_name Go_back = "go back"

let machine =
  Machine.make ~id:"about" ~init:About ~name ~states ~event_name
    ~fingerprint:state_fingerprint
    ~entry:(fun About -> [ Action.Set_title "About" ])
    (fun About Go_back -> Stay [ Action.Back ])

let history =
  List.init 40 (fun i ->
      <p>(Node.text (Printf.sprintf "Release note %d." (i + 1)))</p>
  )

let view About : event Node.t =
  <div>
    (Node.element "h1"
       [ Attr.bool "data-silica-route-focus" true ]
       [ Node.text "About" ]
    )
    (Example_nav.make ())
    <p>"Silica is a view framework where all behaviour is statecharts."</p>
    <button on_press=Go_back>"Back"</button>
    <section><h2>"Release notes"</h2> (Node.list history)</section>
    <section id="credits"><h2>"Credits"</h2> <p>"Made with OCaml."</p></section>
  </div>

let component = Component.make machine view
let make ?key () = Component.node ?key component
