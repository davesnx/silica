open Silica
open Example_routes

let render : route -> Router.event Node.t = function
  | Home ->
      <Example_home />
  | Item id ->
      <Example_item id />
  | About ->
      <Example_about />
  | Edit ->
      <Example_edit />
  | Locked ->
      <div>
        <h1>"Locked"</h1>
        (Example_nav.make ())
        <p>"This page opens only from its own URL, never from a link."</p>
      </div>
  | Not_found _ ->
      <Example_not_found />

let guard ~from ~target =
  match (from, target) with
  | Some _, Locked ->
      Router.Cancel
  | _ ->
      Router.Allow

let app = Router.make routes ~guard ~render
let status route =
  if Router.is_not_found routes route then
    404
  else
    200
