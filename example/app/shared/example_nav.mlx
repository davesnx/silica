open Silica
open Example_routes

let text = Node.text
let link route label = Router.link routes route [] [ text label ]

let make () =
  <nav>
    (link Home "Home")
    (link (Item 1) "Item 1")
    (link (Item 2) "Item 2")
    (link About "About")
    (link Edit "Edit")
    (Router.link ~hash:"credits" routes About [] [ text "Credits" ])
  </nav>
