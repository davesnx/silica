open Silica
open Example_routes

let text = Node.text
let link state data label = Router.link routes state data [] [ text label ]

let make () =
  <nav>
    (link State.Home () "Home")
    (link State.Item 1 "Item 1")
    (link State.Item 2 "Item 2")
    (link State.About () "About")
    (link State.Edit () "Edit")
    (Router.link ~hash:"credits" routes State.About () [] [ text "Credits" ])
  </nav>
