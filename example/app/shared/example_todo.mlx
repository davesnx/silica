open Silica
open Jsonkit.Primitives

type todo = { id : int; text : string; completed : bool } [@@deriving json]

type state = { todos : todo list; draft : string; next_id : int }
[@@deriving json]

type event = Draft of string | Add | Toggle of int | Delete of int
[@@deriving json, event_shape]

let init = { todos = []; draft = ""; next_id = 1 }
let input_ref = Ref.make "todo-input"

let machine =
  Machine.make ~id:"todo" ~init
    ~shape:(Machine.shape ~name:(fun _ -> "todo") ~names:[ "todo" ] ())
    ~events:event_shape
    (fun state event ->
      match event with
      | Draft draft ->
          Go { state with draft }
      | Add when String.trim state.draft = "" ->
          Stay [ Action.Focus input_ref ]
      | Add ->
          let todo =
            {
              id = state.next_id;
              text = String.trim state.draft;
              completed = false;
            }
          in
          Go_with
            ( {
                todos = state.todos @ [ todo ];
                draft = "";
                next_id = state.next_id + 1;
              },
              [ Action.Focus input_ref ]
            )
      | Toggle id ->
          let flip todo =
            if todo.id = id then
              { todo with completed = not todo.completed }
            else
              todo
          in
          Go { state with todos = List.map flip state.todos }
      | Delete id ->
          Go
            {
              state with
              todos = List.filter (fun todo -> todo.id <> id) state.todos;
            }
    )

let text = Node.text

let row todo =
  Node.keyed (string_of_int todo.id)
    <li>
      <button
        class_=( if todo.completed then
                   "todo done"
                 else
                   "todo"
               )
        on_press=(Toggle todo.id)
        on_double_press=(Delete todo.id)>
        (text
           (( if todo.completed then
                "[x] "
              else
                "[ ] "
            )
           ^ todo.text
           )
        )
      </button>
    </li>

let view (state : state) : event Node.t =
  <section>
    <h2>"Todos"</h2>
    <p>"Press a todo to toggle it, double press to delete it."</p>
    <form on_submit=Add>
      <input
        ref=input_ref
        type_=`text
        value=state.draft
        placeholder="What needs doing?"
        aria_label="New todo"
        on_input=(fun v -> Draft v)
      />
      <button type_=`submit>"Add"</button>
    </form>
    <ul>(Node.list (List.map row state.todos))</ul>
  </section>

let component = Component.make machine view
let make ?key () = Component.node ?key component
