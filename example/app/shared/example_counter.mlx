open Silica
module Counter_event = Example_model.Counter_event

let machine : (unit, int, Counter_event.t) Machine.t =
  Machine.make ~id:"counter" ~init:0
    ~name:(fun _ -> "counter")
    ~states:[ "counter" ] ~event_name:Counter_event.name
    (fun count event ->
      match event with
      | Counter_event.Incr ->
          Go (count + 1)
      | Decr when count = 0 ->
          Ignore
      | Decr ->
          Go (count - 1)
      | Reset ->
          Go 0
    )

let view (count : int) : Counter_event.t Node.t =
  <div class_="counter">
    <button
      on_press=Counter_event.Decr disabled=(not (Machine.can machine count Decr))>
      "Decrement"
    </button>
    <span>(Node.text (string_of_int count))</span>
    <button on_press=Counter_event.Incr>"Increment"</button>
    <button on_press=Counter_event.Reset>"Reset"</button>
  </div>

let component = Component.make machine view

let live =
  Live.declare ~channel:"counter" ~state:Example_model.counter_state
    ~event:Example_model.counter_event component
