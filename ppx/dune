(library
 (name silica_ppx)
 (public_name silica.ppx)
 (kind ppx_rewriter)
 (libraries ppxlib)
 (ppx_runtime_libraries silica)
 (preprocess
  (pps ppxlib.metaquot)))

(rule
 (target fingerprint_versions.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let ocaml = \"%{ocaml_version}\"\n")
    (echo "let melange = \"%{version:melange}\"\n")
    (echo "let ppxlib = \"%{version:ppxlib}\"\n")))))
