stateDiagram-v2
  direction LR
  state "loading (invoke /api/issues)" as s0
  state "failed" as s1
  state "not_found" as s2
  state "ready (invoke live:issues, hold keys)" as s3
  [*] --> s0
  s1 --> s0 : props, retry
  s0 --> s1 : loaded error
  s0 --> s0 : props
  s0 --> s2 : loaded ok
  s0 --> s3 : loaded ok
  s2 --> s0 : props
  s3 --> s0 : props
