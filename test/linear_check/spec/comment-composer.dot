digraph "comment-composer" {
rankdir=LR;
"comment-composer.__init" [shape=point];
"comment-composer.__init" -> "comment-composer.empty";
"comment-composer.empty" [label="empty" shape=box];
"comment-composer.drafting" [label="drafting" shape=box];
"comment-composer.failed" [label="failed" shape=box];
"comment-composer.sending" [label="sending\ninvoke /api/comments/add" shape=box];
"comment-composer.drafting" -> "comment-composer.empty" [label="clear, props, typed"];
"comment-composer.drafting" -> "comment-composer.sending" [label="send"];
"comment-composer.empty" -> "comment-composer.drafting" [label="typed"];
"comment-composer.failed" -> "comment-composer.drafting" [label="typed"];
"comment-composer.failed" -> "comment-composer.empty" [label="clear, props, typed"];
"comment-composer.failed" -> "comment-composer.sending" [label="send"];
"comment-composer.sending" -> "comment-composer.empty" [label="props, sent ok"];
"comment-composer.sending" -> "comment-composer.failed" [label="sent error"];
}
