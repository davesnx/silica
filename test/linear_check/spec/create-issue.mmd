stateDiagram-v2
  direction LR
  state "closed" as s0
  state "editing" as s1
  state "failed" as s2
  state "submitting (invoke /api/issues/create)" as s3
  [*] --> s0
  s0 --> s1 : props
  s1 --> s0 : cancel, props
  s1 --> s3 : submit
  s2 --> s0 : cancel, props
  s2 --> s1 : description, priority_picked, status_picked, title
  s2 --> s3 : submit
  s3 --> s0 : created ok
  s3 --> s2 : created error
