(rule
 (alias runtest)
 (deps no_dev_client.ts %{project_root}/devtools/dist/silica-dev.js)
 (action
  (ignore-stderr
   (with-accepted-exit-codes
    1
    (run node no_dev_client.ts client devtools %{project_root}/devtools/dist)))))

