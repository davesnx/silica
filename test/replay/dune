(executable
 (name gen_script)
 (modules gen_script)
 (libraries replay_fixtures silica silica.check))

(rule
 (with-stdout-to
  save_script.ml
  (run ./gen_script.exe save ignored-event)))

(rule
 (with-stdout-to
  save_fixed_script.ml
  (run ./gen_script.exe save ignored-event Save.fixed)))

(rule
 (with-stdout-to
  save_disabled_script.ml
  (run ./gen_script.exe save ignored-event Save.disabled)))

(rule
 (with-stdout-to
  nameless_script.ml
  (run ./gen_script.exe nameless accessible-name)))

(rule
 (with-stdout-to
  nameless_fixed_script.ml
  (run ./gen_script.exe nameless accessible-name Nameless.fixed)))

(rule
 (with-stdout-to
  crash_script.ml
  (run ./gen_script.exe crash raised)))

(rule
 (with-stdout-to
  upload_retry_script.ml
  (run ./gen_script.exe upload ignored-event)))

(rule
 (with-stdout-to
  upload_error_script.ml
  (run ./gen_script.exe upload short-error)))

(rule
 (with-stdout-to
  labelled_script.ml
  (run ./gen_script.exe labelled accessible-name)))

(rule
 (with-stdout-to
  clock_script.ml
  (run ./gen_script.exe clock ignored-event)))

(rule
 (with-stdout-to
  lost_script.ml
  (run ./gen_script.exe lost "save leads to saved or failed")))

(rule
 (with-stdout-to
  sync_script.ml
  (run ./gen_script.exe sync "sync leads to synced")))

(rule
 (with-stdout-to
  pages_link_script.ml
  (run ./gen_script.exe pages img-alt)))

(rule
 (with-stdout-to
  pages_back_script.ml
  (run ./gen_script.exe pages "home stays behind")))

(rule
 (with-stdout-to
  search_script.ml
  (run ./gen_script.exe search ignored-event)))

(rule
 (with-stdout-to
  typing_script.ml
  (run ./gen_script.exe typing "the step is positive")))

