(executable
 (name gen_script)
 (modules gen_script)
 (libraries replay_fixtures silica silica.check))

(rule
 (with-stdout-to
  save_script.ml
  (run ./gen_script.exe save ignored-event)))

(rule
 (with-stdout-to
  save_fixed_script.ml
  (run ./gen_script.exe save ignored-event Save.fixed)))

