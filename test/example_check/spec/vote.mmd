stateDiagram-v2
  direction LR
  state "idle" as s0
  state "failed" as s1
  state "loading (invoke /api/vote)" as s2
  state "ready" as s3
  state "rejected" as s4
  [*] --> s0
  s1 --> s2 : load, retry
  s0 --> s2 : load
  s2 --> s1 : settled error
  s2 --> s2 : load
  s2 --> s3 : settled ok
  s2 --> s4 : settled rejected
  s3 --> s2 : load
  s4 --> s2 : load, retry
