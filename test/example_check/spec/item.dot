digraph "item" {
rankdir=LR;
"item.__init" [shape=point];
"item.__init" -> "item.idle";
"item.idle" [label="idle" shape=box];
"item.loading" [label="loading\ninvoke /api/item" shape=box];
"item.loaded" [label="loaded" shape=box];
"item.failed" [label="failed" shape=box];
"item.failed" -> "item.failed";
"item.failed" -> "item.loading" [label="props"];
"item.idle" -> "item.idle";
"item.idle" -> "item.loading" [label="props"];
"item.loaded" -> "item.loaded";
"item.loaded" -> "item.loading" [label="props"];
"item.loading" -> "item.failed" [label="settled error"];
"item.loading" -> "item.loaded" [label="settled ok"];
"item.loading" -> "item.loading" [label="props"];
}
