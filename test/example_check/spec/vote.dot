digraph "vote" {
rankdir=LR;
"vote.__init" [shape=point];
"vote.__init" -> "vote.idle";
"vote.idle" [label="idle" shape=box];
"vote.failed" [label="failed" shape=box];
"vote.loading" [label="loading\ninvoke /api/vote" shape=box];
"vote.ready" [label="ready" shape=box];
"vote.rejected" [label="rejected" shape=box];
"vote.failed" -> "vote.loading" [label="load, retry"];
"vote.idle" -> "vote.loading" [label="load"];
"vote.loading" -> "vote.failed" [label="settled error"];
"vote.loading" -> "vote.loading" [label="load"];
"vote.loading" -> "vote.ready" [label="settled ok"];
"vote.loading" -> "vote.rejected" [label="settled rejected"];
"vote.ready" -> "vote.loading" [label="load"];
"vote.rejected" -> "vote.loading" [label="load, retry"];
}
