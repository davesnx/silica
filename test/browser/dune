(data_only_dirs node_modules)

(melange.emit
 (target out)
 (alias browser-build)
 (modules app host_app ui_app hot_app_a hot_app_b)
 (module_systems
  (esm mjs))
 (preprocess
  (pps silica.ppx melange.ppx))
 (libraries
  silica
  silica.browser
  silica.json-melange
  silica-ui
  silica_site_app_melange
  test_apps))

(rule
 (alias browser-test)
 (deps
  (alias browser-build)
  browser.test.mjs
  host.test.mjs
  ui.test.mjs
  devtools.test.mjs
  hot.test.mjs
  mount.test.mjs
  hot_a.mjs
  hot_b.mjs
  %{project_root}/devtools/dist/silica-dev.js
  package.json
  (source_tree node_modules))
 (action
  (run
   node
   --test
   browser.test.mjs
   host.test.mjs
   ui.test.mjs
   devtools.test.mjs
   hot.test.mjs
   mount.test.mjs)))

(rule
 (targets hot_a.mjs hot_b.mjs)
 (deps
  (alias browser-build)
  (source_tree %{project_root}/example/client/node_modules))
 (action
  (progn
   (run
    %{project_root}/example/client/node_modules/esbuild/bin/esbuild
    out/test/browser/hot_app_a.mjs
    --bundle
    --format=esm
    --inject:out/node_modules/silica.browser/hot_reload.mjs
    --outfile=hot_a.mjs
    --log-level=warning)
   (run
    %{project_root}/example/client/node_modules/esbuild/bin/esbuild
    out/test/browser/hot_app_b.mjs
    --bundle
    --format=esm
    --inject:out/node_modules/silica.browser/hot_reload.mjs
    --outfile=hot_b.mjs
    --log-level=warning))))
