 (name export)
 (modules export)
 (libraries silica silica.check ui_checks))

(rule
 (targets
  note-dialog.qnt
  note-dialog.dot
  filter-popover.qnt
  filter-popover.dot
  tooltip.qnt
  tooltip.dot
  menu.qnt
  menu.dot
  select.qnt
