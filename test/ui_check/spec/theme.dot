digraph "theme" {
rankdir=LR;
"theme.__init" [shape=point];
"theme.__init" -> "theme.system";
"theme.system" [label="system\nhold media" shape=box];
"theme.fixed" [label="fixed" shape=box];
"theme.fixed" -> "theme.system" [label="choose system, props"];
"theme.system" -> "theme.fixed" [label="choose high-contrast, choose light, props"];
}
