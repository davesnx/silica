digraph "switch" {
rankdir=LR;
"switch.__init" [shape=point];
"switch.__init" -> "switch.unchecked";
"switch.unchecked" [label="unchecked" shape=box];
"switch.checked" [label="checked" shape=box];
"switch.checked" -> "switch.unchecked" [label="props, toggle"];
"switch.unchecked" -> "switch.checked" [label="props, toggle"];
}
