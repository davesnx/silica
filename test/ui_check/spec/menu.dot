digraph "menu" {
rankdir=LR;
"menu.__init" [shape=point];
"menu.__init" -> "menu.closed";
"menu.closed" [label="closed" shape=box];
"menu.open" [label="open\nhold dismiss\nhold anchor" shape=box];
"menu.closed" -> "menu.open" [label="open first list-navigation, open first trigger-press, open last list-navigation, props, trigger press"];
"menu.open" -> "menu.closed" [label="choose, close escape-key, close focus-out, close outside-press, props, trigger press"];
}
