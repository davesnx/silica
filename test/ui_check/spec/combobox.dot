digraph "combobox" {
rankdir=LR;
"combobox.__init" [shape=point];
"combobox.__init" -> "combobox.closed";
"combobox.closed" [label="closed" shape=box];
"combobox.inline" [label="inline" shape=box];
"combobox.open" [label="open\nhold dismiss\nhold anchor" shape=box];
"combobox.closed" -> "combobox.inline" [label="props"];
"combobox.closed" -> "combobox.open" [label="next, previous, show, type"];
"combobox.inline" -> "combobox.closed" [label="props"];
"combobox.open" -> "combobox.closed" [label="enter, escape, focus-out, outside, press"];
"combobox.open" -> "combobox.inline" [label="props"];
}
