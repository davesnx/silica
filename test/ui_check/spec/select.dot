digraph "select" {
rankdir=LR;
"select.__init" [shape=point];
"select.__init" -> "select.closed";
"select.closed" [label="closed" shape=box];
"select.open" [label="open\nhold dismiss\nhold anchor" shape=box];
"select.closed" -> "select.open" [label="open_key list-navigation, open_key trigger-press, trigger_press"];
"select.open" -> "select.closed" [label="close escape-key, close focus-out, close item-press, close outside-press, select focus-out, select item-press, trigger_press"];
}
