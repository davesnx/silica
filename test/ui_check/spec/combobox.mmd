stateDiagram-v2
  direction LR
  state "closed" as s0
  state "inline" as s1
  state "open (hold dismiss, hold anchor)" as s2
  [*] --> s0
  s0 --> s1 : props
  s0 --> s2 : move next, move previous, show, typed
  s1 --> s0 : props
  s2 --> s0 : choose, choose_highlighted, escape, focus_out, outside_press
  s2 --> s1 : props
