digraph "command-menu" {
rankdir=LR;
"command-menu.__init" [shape=point];
"command-menu.__init" -> "command-menu.closed";
"command-menu.closed" [label="closed" shape=box];
"command-menu.open" [label="open\nhold focus_trap\nhold scroll_lock\nhold dismiss" shape=box];
"command-menu.closed" -> "command-menu.open" [label="props"];
"command-menu.open" -> "command-menu.closed" [label="close escape-key, close outside-press, props, run"];
}
