digraph "checkbox" {
rankdir=LR;
"checkbox.__init" [shape=point];
"checkbox.__init" -> "checkbox.unchecked";
"checkbox.unchecked" [label="unchecked" shape=box];
"checkbox.checked" [label="checked" shape=box];
"checkbox.indeterminate" [label="indeterminate" shape=box];
"checkbox.checked" -> "checkbox.indeterminate" [label="props"];
"checkbox.checked" -> "checkbox.unchecked" [label="props, toggle"];
"checkbox.indeterminate" -> "checkbox.checked" [label="props, toggle"];
"checkbox.indeterminate" -> "checkbox.unchecked" [label="props"];
"checkbox.unchecked" -> "checkbox.checked" [label="props, toggle"];
"checkbox.unchecked" -> "checkbox.indeterminate" [label="props"];
}
